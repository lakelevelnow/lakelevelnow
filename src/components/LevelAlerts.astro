---
// CRO 2026-11-13 (livedata impl): a fixed level-alerts sign-up for one lake. Same Worker
// endpoint, offer id and GA4 events as WaitlistTest (offer_id "alerts"), but always shown,
// not one card of five. Alerts are not built yet, so the copy says "waitlist": the visitor
// gets one email when they start. Optional line for local businesses links /advertise/.
// GA4: view_promotion (50% visible), select_promotion (focus), generate_lead (new sign-up).
import dir from '../data/directory.json';
interface Props { slug: string; name: string; placement: string; cro: string; business?: boolean }
const { slug, name, placement, cro, business } = Astro.props;
const place = /^[a-z0-9-]{1,40}$/.test(placement) ? placement : 'lake-alerts';
const WORKER = 'https://lake-level-almanac.lipmichal.workers.dev/waitlist';
const id = `la-${place}`;
---
<section class="la" id="lln-alerts" data-cro={cro} data-la-lake={slug} data-la-place={place} data-la-endpoint={WORKER} aria-labelledby={`${id}-t`}>
  <p class="la-k">Free waitlist</p>
  <h2 class="la-t" id={`${id}-t`}>Get an email when {name} crosses a level you pick</h2>
  <p class="la-b">Level alerts for {name} are being built. Join the list and you get one email when they start. Founding price after launch: $19 a year. Joining is free and you can ignore it.</p>
  <form class="la-f" novalidate>
    <label class="la-l" for={`${id}-e`}>Your email address</label>
    <div class="la-row">
      <input class="la-e" id={`${id}-e`} name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required />
      <button type="submit" class="la-s" data-cta={`${place.replace(/-/g, '_')}_join`.slice(0, 40)}>Email me when alerts start</button>
    </div>
    <div class="la-hp" aria-hidden="true"><label>Leave this empty <input type="text" name="hp_wl" tabindex="-1" autocomplete="off" /></label></div>
    <p class="la-n">One email when it is ready. Nothing else. <a href="/privacy/#waitlist">Privacy policy</a></p>
    <p class="la-st" role="status" aria-live="polite"></p>
  </form>
  {business && (
    <p class="la-biz" data-cro={`${cro}-advertise`}>Run a marina, boat rental or guide service at {name}? <a href="/advertise/" data-cta="alerts_box_advertise">Get listed on the {name} level page, ${dir.priceUsd} a year</a></p>
  )}
</section>
<script is:inline>
(function () {
  var boxes = document.querySelectorAll('section.la[data-la-endpoint]');
  for (var b = 0; b < boxes.length; b++) (function (root) {
    if (root.dataset.laInit) return;
    root.dataset.laInit = '1';
    var params = { offer_id: 'alerts', ab_variant: 'alerts', lake_slug: root.getAttribute('data-la-lake') || '', placement: root.getAttribute('data-la-place') || 'lake-alerts' };
    function ga(name) {
      if (typeof window.__siteGA4Event === 'function') { window.__siteGA4Event(name, params); return; }
      document.addEventListener('site-ga4-ready', function () { if (typeof window.__siteGA4Event === 'function') window.__siteGA4Event(name, params); }, { once: true });
    }
    if (window.IntersectionObserver) {
      var io = new IntersectionObserver(function (es) {
        for (var k = 0; k < es.length; k++) if (es[k].isIntersecting && es[k].intersectionRatio >= 0.5) { ga('view_promotion'); io.disconnect(); }
      }, { threshold: 0.5 });
      io.observe(root);
    }
    var form = root.querySelector('.la-f'), email = root.querySelector('.la-e'), send = root.querySelector('.la-s'),
        st = root.querySelector('.la-st'), hp = root.querySelector('input[name="hp_wl"]'), picked = false, busy = false;
    email.addEventListener('focus', function () { if (!picked) { picked = true; ga('select_promotion'); } });
    var RE = /^[^\s@"<>()[\]\\,;:]{1,64}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\.[a-z]{2,24}$/i;
    function say(t, bad) { st.textContent = t; st.classList.toggle('la-bad', !!bad); }
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      if (busy) return;
      var v = String(email.value || '').trim();
      if (v.length > 254 || !RE.test(v)) { email.setAttribute('aria-invalid', 'true'); say('Please enter a valid email address.', true); email.focus(); return; }
      email.removeAttribute('aria-invalid');
      busy = true; send.disabled = true; say('Sending');
      function fail(t) { busy = false; send.disabled = false; say(t, true); }
      fetch(root.getAttribute('data-la-endpoint'), { method: 'POST', mode: 'cors', credentials: 'omit',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: v, offer_id: 'alerts', ab_variant: 'alerts', lake_slug: params.lake_slug, placement: params.placement, hp: hp ? hp.value : '' })
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (j) {
          if (res.status === 200 && j && j.ok) {
            if (!j.dup) ga('generate_lead');
            form.querySelector('.la-row').hidden = true; form.querySelector('.la-l').hidden = true;
            say('Thanks. You are on the list. One email when alerts start.');
            return;
          }
          fail(res.status === 429 ? 'Too many sign-ups from this connection today. Please try again tomorrow.' : 'Sorry, that did not work. Please try again in a minute.');
        });
      }).catch(function () { fail('Sorry, that did not work. Please try again in a minute.'); });
    });
  })(boxes[b]);
})();
</script>
<style>
  .la { margin: 22px 0; max-width: 760px; padding: 16px 20px; border: 1px solid var(--border); border-left: 4px solid var(--teal); border-radius: var(--r); background: var(--card); }
  .la [hidden] { display: none !important; }
  .la-k { margin: 0 0 4px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--teal); }
  .la-t { margin: 0 0 6px; font-size: 19px; line-height: 1.3; }
  .la-b { margin: 0 0 12px; font-size: 15px; line-height: 1.5; color: var(--t1); }
  .la-l { display: block; margin: 0 0 6px; font-weight: 600; font-size: 14px; }
  .la-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .la-e { flex: 1 1 220px; min-width: 0; min-height: 46px; padding: 10px 12px; box-sizing: border-box; border: 1px solid var(--border); border-radius: 6px; background: #fff; color: var(--t1); font: 16px/1.2 var(--sans); }
  .la-e[aria-invalid="true"] { border-color: var(--burnt); }
  .la-s { min-height: 46px; padding: 10px 18px; border: 0; border-radius: 6px; background: var(--teal); color: #fff; font: 600 15px/1.2 var(--sans); cursor: pointer; }
  .la-s:hover { background: var(--teal-deep); }
  .la-s:disabled { opacity: .6; cursor: progress; }
  .la-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .la-n { margin: 8px 0 0; font-size: 13px; color: var(--t2); }
  .la-st { margin: 6px 0 0; font-size: 14px; color: var(--teal-deep); }
  .la-st.la-bad { color: var(--burnt); }
  .la-st:empty { display: none; }
  .la-biz { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--border); font-size: 15px; line-height: 1.5; color: var(--t2); }
  .la-biz a { display: inline-block; padding: 8px 0; font-weight: 600; }
  @media (max-width: 480px) { .la { padding: 14px 16px; } .la-s { flex: 1 1 100%; } }
</style>
