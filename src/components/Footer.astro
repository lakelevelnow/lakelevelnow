---
// Global footer — dark slate, LakeLevelNow wordmark, zovo.one + GitHub, disclaimer.
import { SITE } from '../consts';
import alm from '../data/almanac.json';
import SupportLine from './SupportLine.astro';
import { LAKES, freshLakes } from '../lib/lakes';
const featured = freshLakes().slice(0, 6).map((x) => x.lake);
const more = LAKES.slice(6, 14);
const year = new Date().getFullYear();
const ZOVO = 'https://zovo.one';
const GH = 'https://github.com/theluckystrike';
// No tip ask on the support page itself (it has its own) or on the post-purchase page.
const fpath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// adsense-w2: no tip ask in the footer of lake pages (the same self-promotion text on every
// lake page); /support/ and the footer Support link keep it reachable.
// CRO 2026-11-06 R3: no tip ask on the two pages that sell the Almanac (/ and /almanac).
// Mobile money 2026-11-08 (llp): the owner's Almanac line below stays word for word on every page.
// Lake Mead and Lake Powell pages and /posters/ add one separate poster line after it.
const posterPage = /^\/lake\/lake-(mead|powell)(\/|$)/.test(fpath) || fpath === '/posters';
const showTip = fpath !== '/support' && fpath !== '/' && fpath !== '/almanac' && !fpath.startsWith('/almanac/thanks') && !fpath.startsWith('/lake/');
---
<footer class="site-footer">
  <div class="container">
    <div class="frow">
      <div>
        <div class="fbrand"><span class="w">Lake</span><span class="b">Level</span><span class="w">Now</span></div>
        <div class="fdata">Built solo · Data from USGS, CDEC, USBR, TWDB and USACE</div>
      </div>
      <div class="flinks">
        <a href="/about">About</a>
        <a href="/lakes">All lakes</a>
        <a href="/disclosure">Disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/advertise/">Advertise</a>
        <a href="/support/">Support</a>
        <a href={GH} rel="nofollow noopener">GitHub</a>
        <a href={ZOVO} rel="nofollow noopener">zovo.one</a>
        <a href="/contact/">Contact</a>
        <a href="https://mcp.zovo.one">MCP servers for Claude</a>
      </div>
    </div>
    {/* CRO 2026-11-06 R2: one plain offer line in the footer of every page. */}
    <p class="foffer">Live lake levels are free. The Lake Level Almanac is the paid tier, with the daily history of one lake for ${alm.priceSingleUsd}, or all {alm.lakeCount} Almanac lakes for ${alm.priceBundleUsd}. <a href="/almanac/" data-cta="footer_almanac">See the Almanac and a free sample</a></p>
    {posterPage && <p class="foffer">Lake Mead and Lake Powell also come as posters to print. <a href="/posters/" data-cta="footer_posters">See the posters</a></p>}
    {/* sprint2 2026-11-03: crawl path. The four chart pages and three guides had no link from the
        53 pages Google has indexed, so Google never crawled them (URL Inspection: "unknown to Google").
        Bing finds them through IndexNow, and the Lake Mead chart is now the top Bing landing page. */}
    <nav class="flinks fdeep" aria-label="Charts and guides">
      <a href="/lake/lake-mead/chart/">Lake Mead water level chart</a>
      <a href="/lake/lake-powell/chart/">Lake Powell water level chart</a>
      <a href="/lake/lake-travis/chart/">Lake Travis water level chart</a>
      <a href="/lake/lake-buchanan/chart/">Lake Buchanan water level chart</a>
      <a href="/guides/dead-pool-and-minimum-power-pool/">Dead pool and minimum power pool</a>
      <a href="/guides/boat-ramp-minimum-elevation/">Boat ramp minimum elevations</a>
      <a href="/guides/why-lake-elevations-differ/">Why lake elevations differ</a>
      <a href="/embed/">Free level badge for your site</a>
    </nav>
    <p class="disclaimer">
      {SITE.name} republishes public water-data from the USGS Water Services, the California Data Exchange (CDEC), the Bureau of Reclamation (USBR), the Texas Water Development Board (TWDB) and the U.S. Army Corps of Engineers (USACE CWMS).
      Levels are point-in-time readings and can lag real conditions; always confirm ramp and hazard status with the
      lake operator before you go on the water. Not affiliated with any government agency.
      Lake pages may carry ads (not shown to visitors in the EEA, UK or Switzerland). See <a href="/disclosure" style="color:inherit;text-decoration:underline;">the disclosure page</a>.
    </p>
    {showTip && <SupportLine variant="footer" />}
    {/* Tip card behaviour + support_click gtag events (no network, no cookies). */}
    <script is:inline defer src="/kit/support-v3.js?v=5"></script>
    <div class="copy">© {SITE.name} {year} · A <a href={ZOVO} rel="nofollow noopener" style="color:rgba(255,255,255,.4);text-decoration:underline;">zovo.one</a> site, built by one developer.</div>
  </div>

{/* adsense-w2: the off-topic cross-network "Related calculators" block (storm tracker, grade calculator) is removed. */}

</footer>
