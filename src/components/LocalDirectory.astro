---
// Local business directory under the level (lane LD, 2026-11-09, intel N4 single best bet).
// Listings come only from src/data/directory.json, added by hand after a paid $199 listing.
// No listing, no card. The empty state is one small honest line that invites businesses.
// Rules. Label "Sponsor" on every card (FTC native-ad guide). Paid links carry
// rel="sponsored nofollow" (Google). Call and Website buttons are at least 44 px tall.
// At most 3 cards show. With more listings, a tiny inline script picks 3 at random per view.
// GA4 through window.__siteGA4Event, mm_cta_view and mm_cta_click with sku lld (see Header.astro).
// Sponsor clicks also go through ga4.js data-spon as select_content, slug and kind only.
import data from '../data/directory.json';
import { listingsFor, fmtPhone } from '../lib/directory.mjs';

// part 'listings' renders real listings only (the slot right under the reading). part 'invite'
// renders the empty-state line only, placed by the page after the Almanac block, so the visitor's
// own offer comes first while there are no listings.
interface Props { slug: 'lake-mead' | 'lake-powell'; lakeName: string; placement: string; part: 'listings' | 'invite' }
const { slug, lakeName, placement, part } = Astro.props;
const place = /^[a-z0-9-]{1,40}$/.test(placement) ? placement : 'lake-dir';
const all = listingsFor(data, slug, undefined, false);
const max = data.maxShown;
---
{part === 'listings' && all.length > 0 && (
  <section class="ldir" aria-label={`${lakeName} businesses`} data-ldir={slug} data-ldir-max={max}
           data-mm-sku="lld" data-mm-place={place}>
    <p class="ldir-k">{lakeName} businesses</p>
    {all.map((l, i) => (
      <div class="ldir-card" data-ldir-i={i} hidden={i >= max}>
        <p class="ldir-label">Sponsor</p>
        <p class="ldir-name">{l.name}</p>
        <p class="ldir-line">{l.line}</p>
        <p class="ldir-btns">
          {l.phone && <a class="ldir-btn" href={`tel:+1${l.phone}`} data-spon={slug} data-spon-kind="paid" data-cta="dir_call" aria-label={`Call ${l.name}, ${fmtPhone(l.phone)}`}>Call</a>}
          {l.website && <a class="ldir-btn ldir-web" href={l.website} rel="sponsored nofollow noopener" target="_blank" data-spon={slug} data-spon-kind="paid" data-cta="dir_website">Website</a>}
        </p>
      </div>
    ))}
    <p class="ldir-foot"><a href="/advertise/" data-mm-link>List your business here</a></p>
  </section>
)}
{part === 'invite' && all.length === 0 && (
  <p class="ldir-empty" data-ldir={slug} data-mm-sku="lld" data-mm-place={place}>
    Run a boat rental, guide service or place to stay at {lakeName}? Your business can be listed right here.
    <a href="/advertise/" data-mm-link>See how it works</a>
  </p>
)}

{all.length > max && (
  <script is:inline>
  (function () {
    var box = document.querySelectorAll('section.ldir[data-ldir-max]');
    for (var b = 0; b < box.length; b++) {
      var cards = box[b].querySelectorAll('.ldir-card');
      var max = Number(box[b].getAttribute('data-ldir-max')) || 3;
      var idx = [];
      for (var i = 0; i < cards.length; i++) idx.push(i);
      for (var j = idx.length - 1; j > 0; j--) { var r = Math.floor(Math.random() * (j + 1)); var t = idx[j]; idx[j] = idx[r]; idx[r] = t; }
      var foot = box[b].querySelector('.ldir-foot');
      for (var k = 0; k < cards.length; k++) { cards[idx[k]].hidden = k >= max; box[b].insertBefore(cards[idx[k]], foot); }
    }
  })();
  </script>
)}

<style>
  .ldir { margin: 18px 0 8px; max-width: 760px; }
  .ldir-k { margin: 0 0 8px; font-size: 16px; font-weight: 600; color: var(--t1); }
  .ldir-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 12px 16px 14px; margin: 0 0 10px; }
  .ldir-card[hidden] { display: none; }
  .ldir-label { margin: 0 0 4px; font-size: 16px; letter-spacing: .04em; text-transform: uppercase; color: var(--t2); font-weight: 600; }
  .ldir-name, .ldir-line { overflow-wrap: anywhere; }
  .ldir-name { margin: 0 0 2px; font-size: 18px; font-weight: 700; color: var(--t1); }
  .ldir-line { margin: 0 0 10px; font-size: 16px; line-height: 1.45; color: var(--t2); }
  .ldir-btns { display: flex; gap: 10px; margin: 0; }
  .ldir-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 112px; padding: 0 18px;
    border-radius: var(--r-sm); border: 1px solid var(--teal); color: var(--teal); font-weight: 600; font-size: 16px; }
  .ldir-btn:hover { text-decoration: none; background: var(--teal-bg); }
  .ldir-foot { margin: 4px 0 0; font-size: 16px; }
  .ldir-foot a, .ldir-empty a { display: inline-block; padding: 10px 0; font-weight: 600; }
  .ldir-empty { margin: 14px 0 4px; max-width: 760px; font-size: 16px; line-height: 1.5; color: var(--t2);
    border-left: 3px solid var(--border); padding: 2px 0 0 12px; }
  @media (max-width: 560px) { .ldir-btn { flex: 1; } }
</style>
