---
// Voluntary tip asks (PayPal $3 + Buy Me a Coffee), v3 2026-10-17.
// variant "result": a small card right after the live reading (lake pages + homepage).
//   Always visible when rendered (data-sct-always); /kit/support-v3.js (loaded once in
//   Footer.astro) counts uses in this browser only, swaps in the returning copy from the
//   3rd use, and "Not now" hides the card for 30 days. gtag support_click is sent there too.
// variant "footer": the shared footer block on every page, with a "Why I ask" link to /support/.
// The paid almanac stays the primary offer: the result card uses ghost buttons so it never
// outranks the almanac button.
// Numbers: domain renewal $11.08/yr (Porkbun .com list price, fetched 2026-10-17);
// ~300 people a month = 321 GSC clicks in 28 days, rounded down; 5 tips of $3 (~$2.40 net
// after PayPal fees each) cover $11.08. Source: support-cta-work/v3/research/R4-our-audit.json.
import cfg from '../data/monetization.json';
interface Props { variant?: 'result' | 'footer'; headline?: string | null }
const { variant = 'result', headline = null } = Astro.props;
const BMC = cfg.support.bmc;
const PAYPAL = cfg.support.paypal;
const cup = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 8h1a4 4 0 0 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><path d="M6 2v2M10 2v2M14 2v2"/></svg>';
---
{variant === 'result' ? (
  <aside class="tip-card" data-support-cta="result" data-sct-always aria-label="Support LakeLevelNow">
    <div class="tip-who">
      <picture><source srcset="/kit/michael-128.webp" type="image/webp" /><img class="tip-face" src="/kit/michael-128.jpg" width="32" height="32" loading="lazy" alt="Michael Lip" /></picture>
      <div>
        <div data-sct-variant="first">
          {headline && <p class="tip-h">{headline}</p>}
          <p class="tip-b">I'm Michael. I keep these lake readings up to date myself. The domain costs about $11 a year, so a $3 tip covers three months of it. Tips unlock nothing, and the site stays free for everyone.</p>
        </div>
        <div data-sct-variant="returning" hidden>
          <p class="tip-h">Back for lake check number <span data-sct-uses>3</span>.</p>
          <p class="tip-b">Glad these readings keep saving you a wasted trip to the ramp. If LakeLevelNow has earned a coffee, $3 keeps the domain paid for three months. Same free readings either way.</p>
        </div>
      </div>
    </div>
    <div class="tip-row">
      <a class="btn ghost tip-btn" href={`${PAYPAL}/3USD`} target="_blank" rel="noopener" data-rail="paypal">Tip $3 with PayPal</a>
      <a class="tip-btn tip-sec" href={BMC} target="_blank" rel="noopener" data-rail="bmc"><Fragment set:html={cup} /><span>Buy me a coffee <small>card, no account</small></span></a>
      <button type="button" class="tip-not" data-sct-dismiss>Not now</button>
    </div>
  </aside>
) : (
  <div class="tip-foot" data-support-cta="footer">
    <div class="tip-fwho">
      <picture><source srcset="/kit/michael-128.webp" type="image/webp" /><img class="tip-face" src="/kit/michael-128.jpg" width="40" height="40" loading="lazy" alt="Michael Lip" /></picture>
      <p class="tip-fh">LakeLevelNow is one person's side project.</p>
    </div>
    <p class="tip-fb">I'm Michael. The domain costs me about $11 a year, and hosting and the gage data are free. About 300 people find the site on Google each month, so if 5 of them tip $3, the domain is paid for the year. The site stays free either way.</p>
    <div class="tip-row">
      <a class="btn tip-btn" href={`${PAYPAL}/3USD`} target="_blank" rel="noopener" data-rail="paypal">Tip $3 with PayPal</a>
      <a class="btn tip-btn tip-alt" href={BMC} target="_blank" rel="noopener" data-rail="bmc"><Fragment set:html={cup} /><span>Buy me a coffee <small>card, no account</small></span></a>
      <a class="tip-why" href="/support/">Why I ask</a>
    </div>
  </div>
)}
<style>
.tip-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px 20px;margin:18px 0;max-width:660px}
.tip-card[hidden],.tip-card [hidden]{display:none}
.tip-h{margin:0;font-size:15px;font-weight:600;color:var(--t1)}
.tip-who{display:flex;align-items:flex-start;gap:10px}
.tip-who .tip-b{margin-top:4px}
.tip-face{display:block;border-radius:50%;flex:none;object-fit:cover}
.tip-who .tip-face{width:32px;height:32px;margin-top:2px}
.tip-b{margin:0;font-size:14px;line-height:1.55;color:var(--t2)}
.tip-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px;margin-top:12px}
.tip-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;text-decoration:none}
.tip-btn:hover{text-decoration:none}
.tip-btn small{font-size:12px;font-weight:400;opacity:.8;margin-left:4px}
.tip-sec{color:var(--teal);font-size:14px;font-weight:600;padding:10px 8px;border-radius:var(--r-sm)}
.tip-sec:hover{background:var(--teal-bg)}
.tip-not{background:none;border:0;min-height:44px;padding:10px 8px;font:inherit;font-size:13px;color:var(--t3);text-decoration:underline;cursor:pointer}
.tip-not:hover{color:var(--t2)}
.tip-foot{margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,.06);max-width:640px}
.tip-fwho{display:flex;align-items:center;gap:12px}
.tip-fwho .tip-face{width:40px;height:40px}
.tip-fh{margin:0;font-size:14px;font-weight:600;color:#fff}
.tip-fb{margin:8px 0 0;font-size:13px;line-height:1.6;color:rgba(255,255,255,.72)}
.tip-alt{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.4)}
.tip-alt:hover{background:rgba(255,255,255,.08)}
.tip-foot .tip-btn:focus-visible{outline-color:#34b8a0}
.tip-why{color:rgba(255,255,255,.72);font-size:13px;text-decoration:underline;padding:12px 4px}
.tip-why:hover{color:#fff}
@media (max-width:420px){.tip-row .btn.tip-btn{flex:1 1 100%}}
</style>
