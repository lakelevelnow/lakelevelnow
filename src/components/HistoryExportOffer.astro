---
// Sprint 13 S13-8: Concrete Value Proof & Offer Simplification ($9 Historical Level CSV/PDF Export).
// Strict Bot Click-Gate: href="#lake-checkout" + data-checkout="https://buy.stripe.com/..."
// with client_reference_id=s13_lln_<slug>. Zero bare Stripe links in HTML.
import hx from '../data/history-export.json';
import { getReading, getLake } from '../lib/lakes';
import SampleTablePreview from './SampleTablePreview.astro';
import FreeSnapshotCsv from './FreeSnapshotCsv.astro';

interface Props {
  slug?: string;
  place: string;
  singleOffer?: boolean;
}
const { slug, place, singleOffer = false } = Astro.props;
const lake = slug ? hx.lakes.find((l) => l.slug === slug) : undefined;
const ctaText = lake
  ? `Download ${lake.name} Historical CSV + XLSX — $${hx.priceLakeUsd}`
  : `Download One Lake Historical CSV + XLSX — $${hx.priceLakeUsd}`;
const yr = (s: string) => s.slice(0, 4);
const span = (l: typeof hx.lakes[number]) =>
  `${yr(l.start)} to ${l.end.length === 7 ? new Date(l.end + '-15T12:00:00Z').toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : new Date(l.end + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}`;
const first = lake || hx.lakes[0];
const lakeHref = `${hx.linkLake}?client_reference_id=s14_lln_${first.slug}`;
const allHref = `${hx.linkAll}?client_reference_id=s14_lln_${first.slug}_all`;
const emailId = `s14-hx-email-${place}-${first.slug}`;
const reading = getReading(first.slug);
const lakeEntry = getLake(first.slug);
---
<section class="section lln-hx" id="lake-checkout" data-cro="sprint13-s13-8-history" data-alm-place={place}
  data-s2-offer="lln-history-export-lake" data-s2-product="lln-history-export-lake" data-s2-price={String(hx.priceLakeUsd)}>
  {lake ? (
    <>
      <h2 style="margin-bottom:8px;">Download the {lake.name} historical level record ({yr(lake.start)}–{yr(lake.end)})</h2>
      <p class="readable" style="font-size:15px;max-width:660px;">Every {lake.what} reading this site stores for {lake.name}: <strong>{lake.values.toLocaleString('en-US')} {lake.resolution} {lake.source} rows</strong> ({span(lake)}). Ready for Excel, Google Sheets, R, or Python.</p>
    </>
  ) : (
    <>
      <h2 style="margin-bottom:8px;">Historical lake level CSV + XLSX export</h2>
      <p class="readable" style="font-size:15px;max-width:660px;">The stored level record of {hx.lakes.length} lakes as CSV + XLSX: 4 daily records (Mead from 1935, Buchanan from 1937, Travis from 1940, Powell from 1963) and 12 California reservoirs with monthly CDEC storage.</p>
      <p style="font-size:14px;margin:8px 0 4px;"><label>Lake: <select class="lln-hx-pick" aria-label="Pick a lake">
        {hx.lakes.map((l) => <option value={l.slug}>{l.name} ({l.resolution}, from {yr(l.start)})</option>)}
      </select></label></p>
    </>
  )}
  <ul class="lln-proof">
    <li><strong>Instant ZIP download</strong> immediately after checkout — no account, no subscription.</li>
    <li><strong>Clean CSV + Excel XLSX</strong> with {lake ? `${lake.values.toLocaleString('en-US')} ${lake.resolution} ${lake.source} rows` : 'full agency rows'}, yearly summary table, day-of-year percentiles, and a sourced README.</li>
    <li><strong>Works offline forever</strong> in Excel, Google Sheets, R, or Python.</li>
  </ul>

  <SampleTablePreview
    slug={first.slug}
    lakeName={first.name}
    reading={reading}
    fullPoolFt={lakeEntry?.full_pool_ft ?? null}
    source={first.source}
  />

  <FreeSnapshotCsv
    slug={first.slug}
    lakeName={first.name}
    reading={reading}
    fullPoolFt={lakeEntry?.full_pool_ft ?? null}
    source={first.source}
  />

  <label class="lln-hx-email">Email for receipt &amp; backup download link (optional)
    <input type="email" id={emailId} name="email" autocomplete="email" inputmode="email" maxlength="200" placeholder="you@email.com" />
  </label>
  <p class="lln-trust">One-time · Instant download · Refund guarantee · Secure Stripe checkout shown as BeLikeNative / AUTOM8 LLC</p>
  <p class="lln-hx-cta" style="font-size:15px;margin-top:8px;">
    <a class="btn lln-hx-buy" href="#lake-checkout" data-checkout={lakeHref} data-s8-email-from={`#${emailId}`} data-s8-offer="lln-history-export-lake" rel="nofollow noopener" data-lake={first.slug} data-cta="hx_lake_buy" data-cro={`s14_lln_${first.slug}`}>{ctaText}</a>
    {!singleOffer && (
      <span style="margin-left:8px;">or <a class="lln-hx-all" href="#lake-checkout" data-checkout={allHref} data-s8-email-from={`#${emailId}`} data-s8-offer="lln-history-export" rel="nofollow noopener" data-lake={first.slug} data-cta="hx_all_buy" data-cro={`s14_lln_${first.slug}_all`}>all {hx.lakes.length} lakes, ${hx.priceAllUsd}</a></span>
    )}
    <span class="lln-hx-msg" data-s8-msg role="status"></span>
  </p>
  <noscript>
    <p class="lln-noscript">Enable JavaScript to open secure Stripe checkout.</p>
  </noscript>
  {!lake && (
    <script is:inline>
      (function () {
        var s = document.querySelector('.lln-hx-pick'), a = document.querySelector('.lln-hx-buy');
        if (!s || !a) return;
        s.addEventListener('change', function () {
          var raw = a.getAttribute('data-checkout');
          if (!raw) return;
          var u = new URL(raw);
          u.searchParams.set('client_reference_id', 's14_lln_' + s.value);
          a.setAttribute('data-checkout', u.toString());
          a.setAttribute('data-lake', s.value);
        });
      })();
    </script>
  )}
</section>
<style>
  .lln-hx { margin: 18px 0; padding: 16px 20px; border: 1px solid var(--border); border-left: 4px solid var(--teal); border-radius: var(--r); background: var(--card); max-width: 760px; }
  .lln-proof { margin: 10px 0 12px; padding-left: 20px; font-size: 14px; line-height: 1.5; color: var(--t1); }
  .lln-proof li { margin: 4px 0; }
  .lln-hx-email { display: block; margin: 0 0 10px; font-size: 13px; max-width: 360px; }
  .lln-hx-email input { display: block; width: 100%; box-sizing: border-box; min-height: 44px; margin-top: 4px; padding: 8px 10px; border: 1px solid var(--border, #888); border-radius: 6px; font: inherit; font-size: 16px; background: #fff; color: var(--t1); }
  .lln-trust { margin: 8px 0 8px; font-size: 13px; line-height: 1.45; color: var(--t2); }
  .lln-hx-msg { display: block; margin-top: 6px; font-size: 13px; color: var(--burnt); }
  .lln-noscript { margin-top: 8px; font-size: 13px; color: var(--t2); }
</style>
