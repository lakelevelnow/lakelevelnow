---
// The dated short answer block (AEO sprint 2026-10-28).
// 40-60 visible words that answer the page's main question, plus the real date of the
// content check. Keep the answer unique per page: the same text on two pages tells an
// answer engine the pages are duplicates.
interface Props {
  question: string;
  answer: string;
  updated: string;
}
const { question, answer, updated } = Astro.props;
---
<aside class="short-answer" aria-label="Short answer">
  <p class="sa-k">Short answer</p>
  <p class="sa-q">{question}</p>
  <p class="sa-a qas">{answer}</p>
  <p class="sa-d">Updated {updated}</p>
</aside>

<style>
  .short-answer {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--teal);
    border-radius: var(--r);
    padding: 16px 20px;
    margin: 22px 0 0;
    max-width: 680px;
  }
  .sa-k {
    font-size: 11px;
    font-weight: 600;
    color: var(--teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 6px;
  }
  .sa-q {
    font-size: 15px;
    font-weight: 600;
    color: var(--t1);
    margin: 0 0 6px;
    line-height: 1.4;
  }
  .sa-a {
    font-size: 15px;
    color: var(--t1);
    margin: 0 0 8px;
    line-height: 1.55;
  }
  .sa-d {
    font-size: 12px;
    color: var(--t3);
    margin: 0;
  }
</style>
