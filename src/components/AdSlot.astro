---
// One manual AdSense display unit (adsense-mobile 2026-11-02). Positions: top (first natural
// break after the H1 and intro, inside the first phone screen), mid (inside the content) and
// end (after the content, before related links). Unit IDs live in src/data/monetization.json.
// The box renders hidden and reserves no space. /ads-loader.js shows it and reserves the
// height only after the geo gate says load (country known and outside the EEA, UK and CH),
// and hides it again when Google reports the unit unfilled.
import cfg from '../data/monetization.json';
interface Props { pos: 'top' | 'mid' | 'end'; wide?: boolean }
const { pos, wide = false } = Astro.props;
const client = cfg.adsense.client;
const id = (cfg.adsense.slots as Record<string, string>)[pos] || '';
const ok = /^\d{6,20}$/.test(id);
---
{ok && (
  <div class={wide ? 'ad-slot ad-wide' : 'ad-slot'} data-ad-client={client} data-ad-slot-id={id} data-ad-pos={pos} hidden>
    <span class="ad-label">Advertisements</span>
  </div>
)}
