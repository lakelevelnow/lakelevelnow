---
// StatusStrip — the answer in the first phone screen, directly under the H1.
// Cells: percent full, elevation, the level change over the series the feed returned,
// and ramp status. Every cell comes from the SAME reading the gauge and the <title> use,
// so the strip, the title and the JSON-LD cannot disagree. A cell with no data is left
// out; ramp status shows only where a published ramp table exists (Lake Powell, NPS),
// never a guess from the level.
import type { LakeEntry, Reading } from '../lib/lakes';
import { fmtNum, changeOverSeries, powellRamps, powellRampsAsOf } from '../lib/lakes';

interface Props { lake: LakeEntry; reading: Reading; slug: string }
const { lake, reading, slug } = Astro.props;

// Day count of the series. Feeds differ: CDEC/USGS/TWDB return ~30 days, the USBR
// hourly feed returns ~7. The label states the real span, never a fixed "30-day".
const dayOf = (t: string | undefined): number | null => {
  const m = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(t || '');
  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) / 86400000 : null;
};
const series = reading.series || [];
const d0 = dayOf(series[0]?.t);
const d1 = dayOf(series[series.length - 1]?.t);
const spanDays = d0 != null && d1 != null ? d1 - d0 : null;
const change = spanDays != null && spanDays >= 2 ? changeOverSeries(series) : null;
const trendLabel = spanDays != null && spanDays >= 25 ? '30-day trend' : `${spanDays}-day trend`;
const dir = change == null ? null : change > 0.05 ? 'up' : change < -0.05 ? 'down' : 'flat';
const arrow = dir === 'up' ? '↑' : dir === 'down' ? '↓' : '→';
const dirWord = dir === 'up' ? 'rising' : dir === 'down' ? 'falling' : 'flat';

const ftLabel = reading.param?.includes('gage') ? 'gage height' : 'elevation';
const below = reading.feet_from_full;

// Ramps: Lake Powell only, from the NPS ramp table refetched on every build. Hidden when
// the table is older than 30 days, so a stale "open" never reaches the first screen.
let ramps: { open: number; total: number; asOf: string } | null = null;
if (slug === 'lake-powell') {
  const rows = powellRamps();
  const asOf = powellRampsAsOf();
  const ageDays = asOf ? (Date.now() - Date.parse(asOf)) / 86400000 : Infinity;
  if (rows.length && ageDays <= 30) {
    const open = rows.filter((r) => [r.houseboats, r.smallMotorized].some((v) => v === 'available')).length;
    ramps = { open, total: rows.length, asOf: new Date(asOf!).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) };
  }
}

const pctCell = reading.pct_full != null
  ? { v: `${reading.pct_full}%`, l: 'full' }
  : null;
const ftCell = reading.level_ft != null
  ? { v: `${fmtNum(reading.level_ft, 1)} ft`, l: below != null ? `${ftLabel}, ${fmtNum(Math.abs(below), 1)} ft ${below > 0 ? 'below' : 'above'} full` : ftLabel }
  : null;
// Lake Mead readers track elevation against the 1,050 / 1,075 ft shortage tiers, so
// feet lead there; percent full leads everywhere else.
const firstTwo = slug === 'lake-mead' ? [ftCell, pctCell] : [pctCell, ftCell];
---
<div class="status-strip" data-strip={slug} aria-label={`${lake.name} level summary`}>
  {firstTwo.filter(Boolean).map((c) => (
    <div class="ss-cell"><div class="ss-v">{c!.v}</div><div class="ss-l">{c!.l}</div></div>
  ))}
  {change != null && (
    <div class="ss-cell">
      <div class={`ss-v ${dir}`}><span aria-hidden="true">{arrow}</span> {change > 0 ? '+' : change < 0 ? '−' : ''}{fmtNum(Math.abs(change), 1)} ft</div>
      <div class="ss-l">{trendLabel}, {dirWord}</div>
    </div>
  )}
  {ramps && (
    <a class="ss-cell ss-link" href="/lake/lake-powell/boat-ramps/">
      <div class="ss-v">{ramps.open} of {ramps.total}</div>
      <div class="ss-l">ramps open to motorboats (NPS, {ramps.asOf})</div>
    </a>
  )}
</div>

<style>
  .status-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1px;
    background: var(--border); border-radius: var(--r); overflow: hidden; margin: 12px 0 4px; max-width: 760px; }
  .ss-cell { background: var(--card); padding: 10px 12px; display: block; color: inherit; }
  .ss-link:hover { text-decoration: none; background: var(--row-head); }
  .ss-v { font-size: 20px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; color: var(--t1); }
  .ss-v.up { color: var(--teal); } .ss-v.down { color: var(--burnt); } .ss-v.flat { color: var(--t2); }
  .ss-l { font-size: 12px; color: var(--t2); margin-top: 2px; line-height: 1.3; }
  @media (max-width: 520px) { .status-strip { grid-template-columns: repeat(2, 1fr); }
    .ss-cell:last-child:nth-child(odd) { grid-column: span 2; } }
</style>
