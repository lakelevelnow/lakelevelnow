---
// Sprint 14 S14-4: Value-First 1-click Free 7-Day Lake Snapshot CSV (pure client-side Blob, zero server dependency, zero email gate).
import { getReading, getLake, fmtNum, type Reading } from '../lib/lakes';

interface Props {
  slug: string;
  lakeName: string;
  reading?: Reading;
  fullPoolFt?: number | null;
  source?: string;
}

const { slug, lakeName, reading: propReading, fullPoolFt: propFullPool, source } = Astro.props;
const reading = propReading ?? getReading(slug);
const lakeEntry = getLake(slug);
const fullPool = propFullPool !== undefined ? propFullPool : (lakeEntry?.full_pool_ft ?? null);
const feedName = source || (reading?.feed ? reading.feed.toUpperCase() : 'USGS/USBR');

function fmtDateIso(t?: string | null): string {
  const m = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(String(t || ''));
  if (!m) return String(t || '').slice(0, 10) || new Date().toISOString().slice(0, 10);
  return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;
}

function rampStatusFor(elevFt: number | null, fp: number | null, pctFull: number | null): string {
  if (fp != null && elevFt != null) {
    const below = fp - elevFt;
    if (below <= 3) return 'Open (near full pool)';
    if (below <= 12) return 'Mostly open (check low ramps)';
    return 'Low pool (verify ramp cutoff)';
  }
  if (pctFull != null) {
    if (pctFull >= 60) return 'Open (normal pool)';
    if (pctFull >= 35) return 'Caution (some ramps out)';
    return 'Low pool (verify ramp cutoff)';
  }
  return 'Verify local ramp cutoff';
}

interface CsvRow {
  date: string;
  lake: string;
  elevation_ft: string;
  full_pool_ft: string;
  pool_delta_ft: string;
  pct_full: string;
  ramp_status: string;
  source: string;
}

const csvRows: CsvRow[] = [];
const elevSeries = (reading?.series || []).filter((p) => !p.storage && typeof p.v === 'number' && Number.isFinite(p.v));
const recent = elevSeries.slice(-7);

if (recent.length > 0) {
  for (const pt of recent) {
    const deltaVal = fullPool != null ? Math.round((pt.v - fullPool) * 100) / 100 : null;
    csvRows.push({
      date: fmtDateIso(pt.t),
      lake: lakeName,
      elevation_ft: pt.v.toFixed(2),
      full_pool_ft: fullPool != null ? fullPool.toFixed(2) : '',
      pool_delta_ft: deltaVal != null ? deltaVal.toFixed(2) : '',
      pct_full: reading?.pct_full != null ? String(reading.pct_full) : '',
      ramp_status: rampStatusFor(pt.v, fullPool, reading?.pct_full ?? null),
      source: feedName,
    });
  }
} else if (reading && (reading.level_ft != null || reading.pct_full != null)) {
  const v = reading.level_ft;
  const deltaVal = fullPool != null && v != null ? Math.round((v - fullPool) * 100) / 100 : null;
  csvRows.push({
    date: fmtDateIso(reading.as_of),
    lake: lakeName,
    elevation_ft: v != null ? v.toFixed(2) : '',
    full_pool_ft: fullPool != null ? fullPool.toFixed(2) : '',
    pool_delta_ft: deltaVal != null ? deltaVal.toFixed(2) : '',
    pct_full: reading.pct_full != null ? String(reading.pct_full) : '',
    ramp_status: rampStatusFor(v, fullPool, reading.pct_full ?? null),
    source: feedName,
  });
} else {
  csvRows.push({
    date: new Date().toISOString().slice(0, 10),
    lake: lakeName,
    elevation_ft: '',
    full_pool_ft: fullPool != null ? fmtNum(fullPool, 2).replace(/,/g, '') : '',
    pool_delta_ft: '',
    pct_full: '',
    ramp_status: 'Check operator feed before launch',
    source: lakeEntry?.operator || feedName,
  });
}
---

<div class="lln-free-csv" data-cro={`s14-free-csv-${slug}`}>
  <button
    type="button"
    class="lln-free-csv-btn"
    data-lln-free-csv
    data-csv-slug={slug}
    data-csv-rows={JSON.stringify(csvRows)}
    data-cta={`s14_free_csv_${slug}`}
  >
    Download Free 7-Day Lake Snapshot CSV
  </button>
  <span class="lln-free-csv-meta">Instant .csv · {csvRows.length} {csvRows.length === 1 ? 'row' : 'rows'} ({feedName}) · No email required</span>
  <p class="lln-free-csv-ok" data-lln-free-csv-status role="status" aria-live="polite"></p>
</div>

<script is:inline>
(function () {
  if (window.__llnFreeCsvInit) return;
  window.__llnFreeCsvInit = 1;
  function escCsv(v) {
    var s = String(v == null ? '' : v);
    if (/[",\r\n]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
    return s;
  }
  document.addEventListener('click', function (ev) {
    var btn = ev.target && ev.target.closest && ev.target.closest('[data-lln-free-csv]');
    if (!btn) return;
    var slug = btn.getAttribute('data-csv-slug') || 'lake';
    var raw = btn.getAttribute('data-csv-rows') || '[]';
    var rows;
    try { rows = JSON.parse(raw); } catch (_) { rows = []; }
    var header = ['date', 'lake', 'elevation_ft', 'full_pool_ft', 'pool_delta_ft', 'pct_full', 'ramp_status', 'source'];
    var lines = [header.join(',')];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i] || {};
      lines.push(header.map(function (k) { return escCsv(r[k]); }).join(','));
    }
    var csv = lines.join('\r\n') + '\r\n';
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = slug + '-7day-snapshot.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    var box = btn.closest('.lln-free-csv');
    var st = box ? box.querySelector('[data-lln-free-csv-status]') : null;
    if (st) {
      st.textContent = '7-day CSV downloaded \u2014 unlock the complete multi-year historical export + ramp alerts below';
    }
    try {
      if (typeof window.__siteGA4Event === 'function') {
        window.__siteGA4Event('file_download', {
          site: 'lakelevelnow',
          lake_slug: slug,
          file_name: slug + '-7day-snapshot.csv',
          placement: 's14-free-csv'
        });
      }
    } catch (_) {}
  });
})();
</script>

<style>
  .lln-free-csv {
    margin: 12px 0 12px;
    padding: 12px 14px;
    border: 1px dashed var(--teal);
    border-radius: 8px;
    background: var(--bg, #fff);
  }
  .lln-free-csv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 9px 16px;
    border: 1.5px solid var(--teal-deep);
    border-radius: 6px;
    background: #fff;
    color: var(--teal-deep);
    font: 700 14.5px/1.2 var(--sans);
    cursor: pointer;
  }
  .lln-free-csv-btn:hover {
    background: var(--teal-deep);
    color: #fff;
  }
  .lln-free-csv-meta {
    display: inline-block;
    margin-left: 10px;
    font-size: 12.5px;
    color: var(--t2);
  }
  .lln-free-csv-ok {
    margin: 8px 0 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--teal-deep);
  }
  .lln-free-csv-ok:empty {
    display: none;
  }
  @media (max-width: 520px) {
    .lln-free-csv-btn { width: 100%; }
    .lln-free-csv-meta { display: block; margin: 6px 0 0; }
  }
</style>
