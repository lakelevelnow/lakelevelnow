---
// Page shell: head SEO + header + main slot + footer. Used by every page.
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationLd, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  robots?: string;
  // false: use the title as given, without " | LakeLevelNow" (dated lake titles, adsense-1025).
  brand?: boolean;
  jsonLd?: Record<string, any>[];
}
const { title, description, path, ogImage, noindex, robots, brand = true, jsonLd = [] } = Astro.props;
const ld = [organizationLd(), websiteLd(), ...jsonLd];
const adPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const hasAds = !noindex && (adPath === '/' || adPath === '/lakes' ||
  adPath.startsWith('/lake/') || adPath.startsWith('/guides/') ||
  adPath === '/california-lake-levels' || adPath === '/texas-lake-levels');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    {/* AdSense site ownership check. A meta tag only: it loads nothing and sets no cookie,
        so it is safe for every region. The ad script itself is geo-gated in /ads-loader.js. */}
    <meta name="google-adsense-account" content="ca-pub-2241192243363112" />
    {/* Amendment B: reserve the top ad slot before first paint for visitors who will probably
        get ads (time zone outside Europe, live host). The geo gate in /ads-loader.js decides;
        when it says no it removes the class and the space. */}
    {hasAds && <script is:inline>(function(){try{var h=location.hostname;if(!/^(www\.)?lakelevelnow\.com$/.test(h))return;var z=(Intl.DateTimeFormat().resolvedOptions().timeZone)||'';if(!z||/^Europe\//.test(z)||/^Atlantic\/(Reykjavik|Canary|Madeira|Azores|Faroe|Faeroe)$/.test(z))return;document.documentElement.classList.add('ads-likely');}catch(e){}})();</script>}
    {hasAds && <script is:inline defer src="/ads-loader.js"></script>}
    <script is:inline defer src="/ga4.js?v=r2" data-site="lakelevelnow" data-measurement-id="G-LYY6FMNH6R"></script>
    <BaseHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      robots={robots}
      brand={brand}
      jsonLd={ld}
    />
    {/* Almanac funnel beacon. Fire-and-forget GETs to the fulfilment Worker; it never
        blocks navigation and it sends nothing but an event name, a lake slug and a
        placement token. The Worker only counts hits whose Referer is this site. */}
    <script is:inline>
      (function () {
        var B = 'https://lake-level-almanac.lipmichal.workers.dev/hit';
        var ok = /^[a-z0-9-]{0,40}$/;
        var optedOut = navigator.globalPrivacyControl === true ||
          navigator.doNotTrack === '1' || window.doNotTrack === '1';
        function tok(v) { v = String(v || ''); return ok.test(v) ? v : ''; }
        function hit(e, l, p, attemptId) {
          if (optedOut) return;
          var u = B + '?e=' + e + '&l=' + tok(l) + '&p=' + tok(p) +
            (/^[a-f0-9]{32}$/.test(attemptId || '') ? '&a=' + attemptId : '');
          try { fetch(u, { method: 'GET', keepalive: true, mode: 'no-cors' }).catch(function () {}); }
          catch (_) { /* no fetch: the hit is dropped, the page is not */ }
        }
        window.__almHit = hit;
        document.addEventListener('toggle', function (ev) {
          var el = ev.target;
          if (!el || !el.matches || !el.matches('details[data-alm-sample]') || !el.open || el.dataset.sampleCounted) return;
          el.dataset.sampleCounted = '1';
          hit('sample_view', el.getAttribute('data-alm-sample'), 'pine-flat-sample');
        }, true);
        var path = location.pathname.replace(/\/+$/, '');
        if (path === '/almanac') hit('alm_view', '', '');
        if (path === '/almanac/thanks') hit('thanks_view', '', '');
        function onOfferClick(ev) {
          var t = ev.target; if (!t || !t.closest) return;
          var w = t.closest('[data-alm-place]');
          var p = w ? w.getAttribute('data-alm-place') : '';
          var pick = t.closest('a[data-alm-pick]');
          if (pick) { hit('cta_click', 'single', pick.getAttribute('data-alm-pick')); return; }
          var a = t.closest('a[data-alm-buy],a[data-alm-cta],.alm-home-btn');
          if (!a || (a.getAttribute('href') || '').indexOf('https://buy.stripe.com') !== 0) return;
          if (a.dataset && Date.now() - (Number(a.dataset.almT) || 0) < 3000) return;
          if (a.dataset) a.dataset.almT = String(Date.now());
          var m = /client_reference_id=([a-z0-9-]{1,40})/.exec(a.href);
          var slug = a.dataset.checkoutBaseRef || a.getAttribute('data-lake') || (m ? m[1] : 'bundle');
          a.dataset.checkoutBaseRef = slug;
          // Stripe's reference must retain the lake slug: the fulfilment Worker uses it
          // to choose the purchased ZIP. Add a fresh opaque click suffix only when
          // measurement is allowed; old static links remain valid as a fallback.
          var attempt = '';
          if (!optedOut && /^[a-z0-9-]{1,40}$/.test(slug) &&
              window.crypto && typeof window.crypto.randomUUID === 'function') {
            attempt = window.crypto.randomUUID().replace(/-/g, '');
            if (/^[a-f0-9]{32}$/.test(attempt)) {
              var dest = new URL(a.href);
              dest.searchParams.set('client_reference_id', slug + '--' + attempt);
              a.href = dest.href;
              a.dataset.checkoutAttemptId = attempt;
            }
          }
          hit('checkout_open', slug, p, attempt);
        }
        document.addEventListener('click', onOfferClick, true);
        // Middle-click opens the offer in a new tab: count it like a click.
        document.addEventListener('auxclick', function (ev) { if (ev.button === 1) onOfferClick(ev); }, true);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  
{/* adsense-w2: the off-topic cross-network "Related calculators" block (storm tracker, grade calculator) is removed. */}

<script is:inline src="/assets/js/lln-ui.js" defer></script>
</body>
</html>
