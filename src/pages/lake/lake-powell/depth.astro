---
// /lake/lake-powell/depth/ — live water depth at Glen Canyon Dam.
// Content originated from the portfolio-seo-pipeline run 2026-07-16-fix2 (gates L1-L12
// green, H1 information gain 0.6) and was converted from the static artifact to a live
// Astro page so the depth recomputes from src/data on every weekly build, exactly like
// the sibling lake pages. Every displayed number is a deterministic transform of the
// validated reading + published constants; nothing is typed by hand.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DepthGauge from '../../../components/DepthGauge.astro';
import AlmanacContext from '../../../components/AlmanacContext.astro';
import { LAKES, getReading, fmtNum, POWELL_BAND, changeOverSeries, feedLabel, POWELL_HISTORY, POWELL_HISTORY_SOURCE, compareToMark, fmtRecordDate} from '../../../lib/lakes';
import { authorLd, breadcrumbLd, speakableLd, absUrl, orgRef } from '../../../lib/seo';

const lake = LAKES.find((l) => l.slug === 'lake-powell')!;
const reading = getReading('lake-powell');
const live = !!(reading && reading.fresh);
const elev = live ? reading!.level_ft : null;

const band = POWELL_BAND;
const BED = band.fullPoolFt - band.maxDepthFullPoolFt; // 3700 - 561 = 3139, both NPS-published
const depth = elev != null ? Math.round((elev - BED) * 10) / 10 : null;
const depthM = depth != null ? Math.round(depth * 0.3048 * 100) / 100 : null;
const depthPct = depth != null ? Math.round((depth / band.maxDepthFullPoolFt) * 10000) / 100 : null;
const feetBelowFull = elev != null ? Math.round((band.fullPoolFt - elev) * 10) / 10 : null;
const aboveMinPower = elev != null ? Math.round((elev - band.minPowerPoolFt) * 10) / 10 : null;
const aboveDead = elev != null ? Math.round((elev - band.deadPoolFt) * 10) / 10 : null;
const hist = POWELL_HISTORY;
const vsPostFillLow = compareToMark(elev, hist.postFillLowFt, 2);
const bandPct = elev != null ? Math.round(((band.fullPoolFt - elev) / (band.fullPoolFt - band.deadPoolFt)) * 10000) / 100 : null;
const change30d = changeOverSeries(reading?.series);
const delta24h = reading?.delta_24h ?? null;
const asOfFmt = reading?.as_of ? new Date(reading.as_of).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
const asOfIso = reading?.as_of ? String(reading.as_of).slice(0, 10) : '';

const PATH = '/lake/lake-powell/depth/';
const GAGE = 'https://waterdata.usgs.gov/monitoring-location/09379900/';
const NPS = 'https://www.nps.gov/glca/faqs.htm';
const USBR_PDF = 'https://www.usbr.gov/lc/region/g4000/crss5Year.pdf';
const USBR_CSV = 'https://www.usbr.gov/uc/water/hydrodata/reservoir_data/919/csv/49.csv';

// Retargeted 2026-07-27 from "lake powell water depth" to the phrasing that actually earns
// impressions. Search Console over the 90 days to 2026-07-27: "lake powell water depth" got
// ZERO impressions, while "how deep is lake powell right now" got 53 at position 8.21,
// "deepest part of lake powell" 8 at 5.88, and "how deep is lake powell at its deepest point"
// 8 at 6.75 — every one of them at 0.00% CTR. The page was ranking for a question it did not
// ask in its own title. Leading with the live figure gives the searcher the answer in the SERP.
const title = live && depth != null
  ? `Lake Powell depth today: ${fmtNum(depth, 1)} ft at the dam (${fmtNum(band.maxDepthFullPoolFt, 0)} ft max)`
  : 'How deep is Lake Powell right now?';
const description = live && depth != null
  ? `Lake Powell is ${fmtNum(depth, 1)} feet deep at Glen Canyon Dam today, a number computed from the live USGS surface elevation instead of the full-pool figure most articles repeat.`
  : 'Lake Powell\'s water depth at Glen Canyon Dam, computed from the live USGS surface elevation instead of the full-pool figure most articles repeat.';

// Quotable Authority Sentence (GEO), same pattern as the lake pages.
const qas = live && depth != null
  ? `Lake Powell is ${fmtNum(depth, 1)} ft deep at Glen Canyon Dam as of ${asOfFmt}, computed from the USGS gage reading of ${fmtNum(elev, 1)} ft.`
  : '';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How deep is Lake Powell right now?',
  description: 'Lake Powell\'s live water depth at Glen Canyon Dam, recomputed in code from the USGS surface elevation on every build.',
  url: absUrl(PATH),
  mainEntityOfPage: absUrl(PATH),
  datePublished: '2026-07-17',
  dateModified: asOfIso || '2026-07-17',
  author: { '@type': 'Person', name: 'Michael', url: absUrl('/about/'), description: 'Independent developer behind zovo.one, building small fast utility sites including LakeLevelNow. Works on LakeLevelNow full-time.' },
  publisher: orgRef(),
};
const datasetLd = live && depth != null ? {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Lake Powell water depth and elevation, live and derived',
  description: 'Live Lake Powell surface elevation from USGS site 09379900 with code-derived depth at Glen Canyon Dam, operating-band distances, 30-day change, and record-low comparison, recomputed on every build.',
  url: absUrl(PATH),
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Surface elevation', value: String(elev), unitText: 'ft above MSL' },
    { '@type': 'PropertyValue', name: '30-day elevation change', value: change30d != null ? String(change30d) : 'n/a', unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Water depth at Glen Canyon Dam', value: String(depth), unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Water depth at Glen Canyon Dam in meters', value: String(depthM), unitText: 'm' },
    { '@type': 'PropertyValue', name: 'Depth as a share of full-pool depth', value: String(depthPct), unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'Feet below full pool', value: String(feetBelowFull), unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Feet above minimum power pool', value: String(aboveMinPower), unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Feet above dead pool', value: String(aboveDead), unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Share of the live band below full pool', value: String(bandPct), unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'Lowest daily pool elevation since the reservoir first filled', value: String(hist.postFillLowFt), unitText: 'ft above MSL' },
    { '@type': 'PropertyValue', name: `Feet ${vsPostFillLow ? vsPostFillLow.dir : 'from'} the lowest reading since the reservoir first filled`, value: String(vsPostFillLow ? vsPostFillLow.ft : ''), unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Full pool elevation', value: String(band.fullPoolFt), unitText: 'ft above MSL' },
    { '@type': 'PropertyValue', name: 'Maximum depth at the dam at full pool', value: String(band.maxDepthFullPoolFt), unitText: 'ft' },
    { '@type': 'PropertyValue', name: 'Streambed elevation at the dam', value: String(BED), unitText: 'ft above MSL' },
  ],
  creator: { '@type': 'Organization', name: 'U.S. Geological Survey', url: GAGE },
  dateModified: asOfIso || '2026-07-17',
  isAccessibleForFree: true,
} : null;

const ld = [articleLd, ...(datasetLd ? [datasetLd] : []), speakableLd(PATH), authorLd(),
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Lakes', path: '/lakes' }, { name: 'Lake Powell', path: '/lake/lake-powell' }, { name: 'Water depth', path: PATH }])];

const faqs = [
  { q: 'How deep is Lake Powell today?', live: true,
    a: live && depth != null ? `${fmtNum(depth, 1)} ft at Glen Canyon Dam, from the live USGS gage reading of ${fmtNum(elev, 1)} ft. Depth varies across the lake; the dam is the deepest point.` : 'The live gage feed is reconnecting; the depth recomputes from it on every build. Depth varies across the lake; the dam is the deepest point.' },
  { q: 'Why do most articles say Lake Powell is 561 feet deep?', live: false,
    a: 'Because the National Park Service publishes that figure as the maximum depth at Glen Canyon Dam at full pool. The number is real. It just describes a reservoir filled to 3,700 ft, not the surface the gage reads today.' },
  { q: 'Where does the reading come from?', live: false,
    a: 'Parameter code 62614, the reservoir water-surface elevation series at USGS site 09379900, the Lake Powell gage at Glen Canyon Dam, Arizona. The value arrives in feet above datum.' },
  { q: 'What is full pool?', live: false,
    a: `A surface elevation of ${fmtNum(band.fullPoolFt, 0)} ft above mean sea level. At that line Powell runs ${band.lengthMi} miles long with a capacity of ${band.fullCapacityMaf} million acre-feet.` },
  { q: 'What is minimum power pool?', live: false,
    a: `${fmtNum(band.minPowerPoolFt, 0)} ft, the elevation below which Glen Canyon Dam can no longer generate hydroelectricity.${aboveMinPower != null ? ` Today's buffer above it is ${fmtNum(aboveMinPower, 1)} ft.` : ''}` },
  { q: 'What is dead pool?', live: false,
    a: `${fmtNum(band.deadPoolFt, 0)} ft, the elevation below which water can no longer reach the outlet works.${aboveDead != null ? ` Today's buffer above it is ${fmtNum(aboveDead, 1)} ft.` : ''}` },
];
---
<BaseLayout title={title} description={description} path={PATH} jsonLd={ld}>
  <div class="container">

    <div class="crumbs" style="padding-top:20px;">
      <a href="/">Home</a><span class="sep">›</span>
      <a href="/lakes">Lakes</a><span class="sep">›</span>
      <a href="/lake/lake-powell/">Lake Powell</a><span class="sep">›</span>
      <span>Water depth</span>
    </div>

    <div style="padding-top:16px;">
      <h1>How deep is Lake Powell right now?</h1>
      <p style="font-size:13px;color:var(--t2);margin-top:8px;">By <a href="/about/">Michael</a>, independent developer behind <a href="https://zovo.one" rel="noopener">zovo.one</a>.{asOfFmt && ` Data checked ${asOfFmt}.`}</p>
    </div>

    {qas && <p class="qas" data-keyword="lake powell water depth" style="font-size:15px;color:var(--t1);margin-top:14px;max-width:660px;font-weight:500;">{qas}</p>}

    {live && reading ? (
      <DepthGauge reading={reading} bed={BED} maxDepthFt={band.maxDepthFullPoolFt} fullPoolFt={band.fullPoolFt} lakeName="Lake Powell" />
    ) : (
      <div class="callout a" style="margin-top:20px;">
        <p>Live feed reconnecting. The depth recomputes from the <a href={GAGE}>USGS gage</a> on every build; the published reference figures below don't change with the level.</p>
      </div>
    )}

    {/* This page had no call to action at all, and it has the site's best click-through
        rate (1.28% against a 0.74% site average). The depth reading it leads with raises
        exactly the question the almanac answers. */}
    <AlmanacContext slug="lake-powell" level={live && reading ? reading.level_ft : null} asOf={live && reading ? reading.as_of : null} />

    <section class="section airy">
      {live && depth != null && (
        <p class="readable" style="margin-bottom:14px;font-size:15px;">
          Sources for the reading above are <a href={GAGE}>USGS site 09379900</a> for the live elevation and the <a href={NPS}>NPS Glen Canyon FAQ</a> for the published constants, as of {asOfFmt}.
        </p>
      )}
      <p class="readable" style="margin-top:16px;">
        Most pages answering this question hand you the <a href={NPS}>{fmtNum(band.maxDepthFullPoolFt,0)} ft maximum depth</a> the National Park Service publishes for a full reservoir. That figure is real. It just describes a lake filled to the brim, not the one out there today.
      </p>
      <p class="readable">
        So this page computes the number instead. It starts from the live surface elevation at <a href={GAGE}>USGS gage 09379900</a>{elev != null && `, currently ${fmtNum(elev,1)} feet above sea level`}, and subtracts the streambed at the dam. Nobody types it in.
      </p>
      <p class="readable">
        The arithmetic is short. Surface elevation minus the {fmtNum(BED,0)} ft streambed gives the depth. And that streambed figure is itself two published <a href={NPS}>NPS numbers</a> subtracted, the {fmtNum(band.fullPoolFt,0)} ft full pool minus the {fmtNum(band.maxDepthFullPoolFt,0)} ft maximum depth at the dam.
      </p>
    </section>

    <div class="verdict">
      <div class="ic">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 9.5L7.5 13L14 5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>
      <div>
        <div class="vt">Where is this measured? <span class="ok">At the dam, the deepest point.</span></div>
        <div class="vb">Depth varies across the lake, and this reading describes the deepest point, at the dam wall. Powell runs <a href={NPS}>{band.lengthMi} miles at full pool</a>, and the farther you get from the dam, the less this number applies.</div>
      </div>
    </div>

    {depth != null && (
      <section class="section airy">
        <h2>Why another site says Lake Powell is deeper</h2>
        <p class="readable">
          Search this question and you'll get more than one answer. The trackers publish a depth around {fmtNum(depth + (BED - 3132), 0)} ft while this page says {fmtNum(depth, 1)} ft, and both are working from roughly the same surface elevation.
        </p>
        <p class="readable">
          The whole gap is one constant. Depth is surface elevation minus the streambed at the dam, so whichever streambed you pick decides the answer.
        </p>
        <div class="def-table" style="max-width:660px;margin-top:16px;">
          <div class="row"><div class="k">This page</div><div class="vv">streambed {fmtNum(BED, 0)} ft, from <a href={NPS}>NPS</a> {fmtNum(band.fullPoolFt, 0)} minus {fmtNum(band.maxDepthFullPoolFt, 0)}</div></div>
          <div class="row"><div class="k">The trackers</div><div class="vv">streambed 3,132 ft, published without a source</div></div>
          <div class="row"><div class="k">Difference</div><div class="vv">{fmtNum(BED - 3132, 0)} ft, which is the whole disagreement</div></div>
        </div>
        <p class="readable" style="margin-top:16px;">
          Ours is the one you can check. Both inputs come off a single National Park Service page, so you can redo the subtraction yourself. We haven't found a published source for 3,132 ft, which doesn't make it wrong, only unverifiable.
        </p>
      </section>
    )}

    <section class="section airy">
      <h2 style="margin-bottom:14px;">Where today's level sits in the operating band</h2>
      {elev != null && (
        <p class="readable" style="margin-bottom:14px;">
          The surface sits {fmtNum(feetBelowFull,1)} ft below the <a href={NPS}>{fmtNum(band.fullPoolFt,0)} ft full-pool line</a>. For hydropower the number that matters is the gap to minimum power pool, and today that gap is {fmtNum(aboveMinPower,1)} ft above <a href={USBR_PDF}>{fmtNum(band.minPowerPoolFt,0)} ft</a>. Below that line Glen Canyon Dam stops generating.
        </p>
        <p class="readable" style="margin-bottom:14px;">
          The harder floor is <a href={USBR_PDF}>dead pool at {fmtNum(band.deadPoolFt,0)} ft</a>, where water can no longer reach the outlet works. Today's surface holds {fmtNum(aboveDead,1)} ft above it. The difference between the two lines is explained in <a href="/guides/dead-pool-and-minimum-power-pool/">dead pool and minimum power pool</a>.
        </p>
      )}
      <div class="def-table" style="max-width:660px;">
        <div class="row"><div class="k">Full pool ({fmtNum(band.fullPoolFt,0)} ft) · <a href={NPS}>NPS</a></div><div class="vv">{fmtNum(band.maxDepthFullPoolFt,0)} ft deep at the dam</div></div>
        <div class="row"><div class="k">Today · <a href={GAGE}>USGS 09379900</a></div><div class="vv">{depth != null ? `${fmtNum(depth,1)} ft deep at the dam` : 'n/a'}</div></div>
        <div class="row"><div class="k">Lowest since the reservoir first filled ({fmtNum(hist.postFillLowFt,2)} ft, {fmtRecordDate(hist.postFillLowDate)}) · <a href={USBR_CSV}>USBR archive</a></div><div class="vv">{fmtNum(hist.postFillLowFt - BED,1)} ft deep at the dam</div></div>
        <div class="row"><div class="k">Minimum power pool ({fmtNum(band.minPowerPoolFt,0)} ft) · <a href={USBR_PDF}>USBR</a></div><div class="vv">{fmtNum(band.minPowerPoolFt - BED,0)} ft deep at the dam</div></div>
        <div class="row"><div class="k">Dead pool ({fmtNum(band.deadPoolFt,0)} ft) · <a href={USBR_PDF}>USBR</a></div><div class="vv">{fmtNum(band.deadPoolFt - BED,0)} ft deep at the dam</div></div>
      </div>
      <p class="readable" style="margin-top:14px;font-size:15px;">
        Each depth above is the landmark elevation minus the {fmtNum(BED,0)} ft streambed.{bandPct != null && ` By elevation alone, the surface has moved ${fmtNum(bandPct,1)} percent of the way down the band from full pool to dead pool.`}
      </p>
      {bandPct != null && (
        <p class="readable" style="font-size:15px;">
          Read that as an elevation share, not a volume share. A true percent full needs the reservoir's area-capacity curve, which this page doesn't compute, so we don't publish one.
        </p>
      )}
    </section>

    <section class="section airy">
      <h2 style="margin-bottom:8px;">How the depth is changing</h2>
      <p class="readable">
        Every foot the surface moves is a foot of depth at the dam. So elevation changes read straight across as depth changes.
        {delta24h != null && (<> Over the last 24 hours the <a href={GAGE}>gage</a> moved {delta24h === 0 ? 'not at all' : delta24h > 0 ? `up ${fmtNum(delta24h,1)} ft` : `down ${fmtNum(Math.abs(delta24h),1)} ft`}.</>)}
        {change30d != null && (<> Across the roughly 30-day series the surface {change30d === 0 ? 'held flat' : change30d > 0 ? `rose ${fmtNum(change30d,1)} ft` : `fell ${fmtNum(Math.abs(change30d),1)} ft`}.</>)}
      </p>
      {change30d != null && (
        <p class="readable">
          Plenty of pages quote a level. Few recompute a validated month-over-month delta on every build, and that's what this figure is.
        </p>
      )}
      <p class="readable">
        {hist.latestIsPostFillLow && (<>Reclamation's most recent daily reading, {fmtNum(hist.postFillLowFt,2)} ft on {fmtRecordDate(hist.postFillLowDate)}, is the lowest in <a href={USBR_CSV}>its complete daily archive</a> since the reservoir first filled. Of the {hist.totalDays.toLocaleString('en-US')} daily readings back to {fmtRecordDate(hist.recordStart)}, {hist.daysBelowLatest.toLocaleString('en-US')} are lower, and {hist.allLowerDaysArePreFill ? <>every one of them falls between {fmtRecordDate(hist.firstBelowDate)} and {fmtRecordDate(hist.lastBelowDate)}, while the reservoir was still filling for the first time</> : <>they are spread across the record</>}. </>)}
        {!hist.latestIsPostFillLow && vsPostFillLow && (<>Today's surface sits {vsPostFillLow.text} the lowest reading since the reservoir first filled, {fmtNum(hist.postFillLowFt,2)} ft on {fmtRecordDate(hist.postFillLowDate)}, from <a href={USBR_CSV}>Reclamation's daily pool-elevation archive</a>. </>)}
        The whole-record minimum is lower still, {fmtNum(hist.seriesLowFt,2)} ft on {fmtRecordDate(hist.seriesLowDate)}, but that was the initial filling and is not a comparable operating state. Both figures are recomputed from that archive on every build, and the {hist.firstFillCutoff} boundary used for "since first fill" is ours, not Reclamation's. The April 2023 low is documented by <a href="https://earthobservatory.nasa.gov/images/151274/lake-powell-hits-new-low">NASA Earth Observatory</a>.
      </p>
    </section>

    <section class="section airy">
      <h2 style="margin-bottom:8px;">Check the depth for any surface elevation</h2>
      <div class="callout a" style="max-width:660px;">
        <p style="margin-bottom:10px;">Type a surface elevation in feet. The page answers with the water depth at the dam for that surface, the feet below full pool, and the live-band share, using the same formulas every number above uses.</p>
        <label for="depth-input" style="font-size:13px;color:var(--t2);">Surface elevation, ft above sea level</label>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:4px;">
          <input id="depth-input" type="number" inputmode="decimal" step="any" value={elev != null ? String(elev) : ''} placeholder="3523.6" style="width:140px;padding:8px 10px;font-size:15px;" />
          <button id="depth-go" type="button" class="btn">See the depth</button>
        </div>
        <p id="depth-out" role="status" aria-live="polite" style="margin-top:10px;font-size:15px;"></p>
        <noscript><p>The checker needs JavaScript. Every other number on this page is precomputed and shows without it.</p></noscript>
      </div>
      <script is:inline define:vars={{ FULL: band.fullPoolFt, BED, DEAD: band.deadPoolFt }}>
        // NASA Power of 10 applied to the one piece of client JS on this page.
        // Rule 5, assert preconditions: the injected constants and both DOM nodes are
        // checked before anything runs, and the whole thing fails closed if any are bad.
        // Rule 7, check every return value: getElementById and parseFloat are both
        // validated rather than trusted. Rule 2, bound the input: a typed elevation is
        // clamped to a physically sane window so no value can drive a nonsense answer.
        (function () {
          'use strict';
          var MIN_INPUT_FT = 0;        // below sea level is not a reservoir surface
          var MAX_INPUT_FT = 10000;    // far above any US reservoir, bounds the domain

          if (!Number.isFinite(FULL) || !Number.isFinite(BED) || !Number.isFinite(DEAD)) return;
          if (!(BED < DEAD && DEAD < FULL)) return;   // ordering invariant, else the math is meaningless

          var span = FULL - DEAD;
          if (!(span > 0)) return;                    // guards the division below

          var input = document.getElementById('depth-input');
          var out = document.getElementById('depth-out');
          if (!input || !out) return;                 // fail closed, never bind a half-wired widget

          function run() {
            var raw = parseFloat(input.value);
            if (!Number.isFinite(raw)) {
              out.textContent = 'Type an elevation to see its numbers.';
              return;
            }
            if (raw < MIN_INPUT_FT || raw > MAX_INPUT_FT) {
              out.textContent = 'Enter an elevation between ' + MIN_INPUT_FT + ' and ' + MAX_INPUT_FT + ' ft above sea level.';
              return;
            }
            if (raw <= BED) {
              out.textContent = 'An elevation of ' + raw.toFixed(1) + ' ft sits at or below the streambed at the dam (' + BED + ' ft), so there would be no water depth to report at the dam.';
              return;
            }
            var depth = raw - BED;
            var below = FULL - raw;
            if (raw > FULL) {
              out.textContent = 'At a surface elevation of ' + raw.toFixed(1) + ' ft the lake would sit above full pool. The water at the dam would be ' + depth.toFixed(1) + ' ft deep, ' + (0 - below).toFixed(1) + ' ft over the full-pool line.';
              return;
            }
            var pct = (below / span) * 100;
            out.textContent = 'At a surface elevation of ' + raw.toFixed(1) + ' ft, the water at Glen Canyon Dam would be ' + depth.toFixed(1) + ' ft deep, ' + below.toFixed(1) + ' ft below full pool, and ' + pct.toFixed(1) + ' percent of the way down the band from full pool toward dead pool.';
          }

          var go = document.getElementById('depth-go');
          if (go) go.addEventListener('click', run);
          input.addEventListener('input', run);
          if (input.value) run();
        })();
      </script>
    </section>

    <section class="section airy">
      <h2 style="margin-bottom:8px;">Getting on the water</h2>
      <p class="readable">
        A depth reading at the dam won't tell you whether the ramp you're towing to still reaches the water. That depends on where the waterline sits against that one ramp, and it moves as the lake does.
      </p>
      <p class="readable">
        Treat the depth and the trend here as a starting point. The <a href="/lake/lake-powell/">live level page</a> has the full gauge, and the <a href="/lake/lake-powell/chart/">water level chart</a> ranks today against every daily reading Reclamation has published since 1963. If you are towing a boat, <a href="/lake/lake-powell/boat-ramps/">the published minimum elevation for each ramp</a> is the number that decides it. Then check the ramp itself with the people who run it, because these are point-in-time readings and they can lag real conditions.
      </p>
    </section>

    <section class="section airy">
      <h2 style="margin-bottom:4px;">Questions about Lake Powell's depth</h2>
      {faqs.map((f) => <div class="faq-item"><div class="q">{f.q}</div><div class="a">{f.a}</div></div>)}
    </section>

    <section class="section" style="padding-bottom:48px;">
      <h2 style="margin-bottom:8px;">Where these numbers come from</h2>
      <p class="readable">
        Every figure here starts at <a href={GAGE}>USGS NWIS Instantaneous Values, site 09379900</a>, parameter 62614. The Daily Values series for the same site is the cross-check.
      </p>
      <p class="readable">
        Published reference points come from the <a href={NPS}>NPS Glen Canyon FAQ</a> and <a href={USBR_PDF}>Reclamation's five-year projection tables</a>. The record low comes from <a href={USBR_CSV}>Reclamation's daily pool-elevation archive</a>.
      </p>
      <p class="readable">
        Code recomputes every displayed number from the validated reading at build time. None of them is typed by hand, and the feed bindings are pinned in the site's sources file, so this page can't quietly pick up a different gage.
      </p>
      <p class="readable">
        I run LakeLevelNow full-time and pull readings from the same public USGS, CDEC and USBR feeds the operators report to. A fetch that fails keeps the prior reading and labels it "may be delayed" rather than dropping the lake. Anything older than seven days is never labeled live.
      </p>
    </section>

  </div>
