---
// /advertise/thanks/ (lane LD, 2026-11-09). Stripe Payment Link 4gMfZi3se1xm3FHaYZ43S0M redirects
// here with #s={CHECKOUT_SESSION_ID}. The page needs no script. It says plainly that the listing is
// added by hand within 2 business days and how to ask for a refund. noindex, out of the sitemap.
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/directory.json';
import { CHECKOUT_NAME } from '../../consts';
const title = 'Thank you, your lake listing is on its way';
---
<BaseLayout title={title} description="Your lake directory listing is paid. I add it by hand within 2 business days." path="/advertise/thanks/" noindex={true}>
  <div class="container">
    <article class="advt">
      <h1>Thank you for listing your business</h1>
      <p>I add every listing by hand. Yours goes live under the water level within 2 business days, and I email you the moment it is up.</p>
      <p>I use the business name, the website or phone and the one line you typed at checkout. If anything needs a change, or the line is too long to fit, I email you before it goes live.</p>
      <p>Your listing shows on the Lake Mead pages and the Lake Powell page. Want only Lake Mead or only Lake Powell? Email me at <a href="mailto:lipmichal@gmail.com?subject=Lake%20listing%20lake">lipmichal@gmail.com</a> and say which.</p>
      <h2>What happens next</h2>
      <ul>
        <li>Your listing runs for {data.months} months from the day it goes live.</li>
        <li>Then it comes down by itself. Nothing renews and you are not charged again.</li>
        <li>{CHECKOUT_NAME} Stripe emails you the receipt.</li>
      </ul>
      <h2>Refunds</h2>
      <p>Not useful? Email <a href="mailto:lipmichal@gmail.com?subject=Lake%20listing%20refund">lipmichal@gmail.com</a> within 14 days for a full refund. Tell me the business name and I refund it to the same card.</p>
      <p>Want to change your line later? Email the same address and I update it.</p>
      <p class="advt-back"><a href="/lake/lake-mead/">Back to the Lake Mead water level</a></p>
      <p>Michael Lip, LakeLevelNow</p>
    </article>
  </div>
</BaseLayout>

<style>
  .advt { max-width: 680px; padding: 24px 0 48px; }
  .advt p, .advt li { font-size: 16px; line-height: 1.55; }
  .advt a[href^="mailto"] { padding: 12px 0; }
  .advt-back a { display: inline-block; padding: 10px 0; font-weight: 600; }
</style>
