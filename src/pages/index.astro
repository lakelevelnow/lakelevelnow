---
import AdSlot from '../components/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CHECKOUT_NAME } from '../consts';
import { LAKES, freshLakes, byState, getReading, status, fmtNum, stateName } from '../lib/lakes';
import { authorLd, breadcrumbLd } from '../lib/seo';
import { levelStatus } from '../lib/seasonal';
import almanacData from '../data/almanac.json';
import posters from '../data/posters.json';
// Lane LD: first year on the posters, from the same frozen facts the poster files were drawn from.
// Lane H15: start years, not a year count, so the entry never clashes with the Almanac's 64 years.
const pstSince = Object.fromEntries(Object.entries(posters.lakes as Record<string, any>).map(([k, f]) =>
  [k, String(f.first[0]).slice(0, 4)]));
import { almanacContext, leadSentence } from '../lib/almanac';
import SupportLine from '../components/SupportLine.astro';
import ShortAnswer from '../components/ShortAnswer.astro';
import { CONTENT_CHECKED } from '../consts';

// Hand-tuned 2026-10-08 for "lake levels" / "current lake levels" (1,922 impressions, pos 18).
// The count is the lakes that have a live percent-full reading today, never the registry size.
const pctCount = freshLakes().filter((x) => x.reading.pct_full != null).length;
// CRO 2026-11-06 R2: one count on the page. The title, the badge and the short answer all use
// the number of lakes with a current reading.
const title = freshLakes().length >= 5
  ? `Lake levels today: live readings for ${freshLakes().length} US lakes and reservoirs`
  : 'Live US lake & reservoir water levels';
const description = SITE.description;
const fresh = freshLakes();
const toneHex = (t: string) => t === 'red' ? '#bb5a37' : t === 'amber' ? '#b07d1a' : t === 'green' || t === 'cyan' ? '#0b7d6a' : '#8a949a';

const movers = [...fresh]
  .map(({ lake, reading }) => ({ lake, reading, d: Math.abs(reading.delta_24h ?? 0) }))
  .sort((a, b) => b.d - a.d)
  .slice(0, 6);

const states = byState();

const faqs = [
  { q: 'Where does the lake level data come from?', a: `Directly from public water-data feeds, USGS Water Services for most lakes and CDEC for California reservoirs. ${SITE.name} fetches each lake's own gage, so the number you see is the same one the operator reports.` },
  { q: 'How often are the levels updated?', a: 'USGS instantaneous gages update every 15–60 minutes; CDEC storage is daily. Each reading carries a timestamp so you can see exactly when it was taken.' },
  { q: 'What does "percent full" mean?', a: 'Current storage divided by published full capacity, as a percentage. 100% means full pool; low percentages indicate drawdown for drought, flood control, or water supply.' },
  { q: 'Is the level shown in real time?', a: 'Almost. It is the most recent reading from the source, usually minutes to hours old. Always confirm conditions with the lake operator before heading out.' },
];
const ld = [authorLd(), breadcrumbLd([{ name: 'Home', path: '/' }])];
// The homepage carries 22.9% of all site impressions (4,220 in the 46 days to 2026-08-05)
// at an average position of 30.25, and it sold nothing, because it asked for nothing.
// Rather than a generic promo, it leads with whichever covered lake is furthest from its
// own normal today. That is a real headline, it changes on its own, and it is the single
// claim on this domain that no competitor can reproduce.
const almLakes = almanacData.lakes;
const almYearsMin = Math.min(...almLakes.map((l) => l.years));
const almYearsMax = Math.max(...almLakes.map((l) => l.years));
const almFeature = [...almLakes].sort(
  (a, b) => Math.abs(b.percentile - 50) - Math.abs(a.percentile - 50)
)[0];
const ALMANAC_SINGLE = import.meta.env.PUBLIC_ALMANAC_LINK_SINGLE || '';

// CRO 2026-11-06 (L07): the featured sentence came from the August snapshot in almanac.json and
// contradicted the live lake page. Use the same live context as the lake page; with no fresh
// reading, keep the snapshot sentence but name its date.
function liveSentence(l: { slug: string; sentence: string; todayDate: string }) {
  const r = getReading(l.slug);
  const fresh = !!(r && r.fresh);
  const ctx = fresh ? almanacContext(l.slug, r!.level_ft, r!.as_of) : null;
  if (ctx) return leadSentence(ctx);
  const d = new Date(l.todayDate + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
  return `On ${d}, ${l.sentence.charAt(0).toLowerCase()}${l.sentence.slice(1)}`;
}
const almFeatureSentence = almFeature ? liveSentence(almFeature) : '';

---
<BaseLayout title={title} description={description} path="/" jsonLd={ld}>
  <div class="container">

    <section class="hero">
      <div class="live-badge"><span class="dot"></span><span>{fresh.length} lakes live now</span></div>
      <h1>Live US lake &amp; reservoir water levels</h1>
      <p class="lead">Percent full and 30-day trend from USGS and CDEC gages, with a plain-English read on whether you can launch a boat.</p>
      {/* CRO 2026-11-06 R2: say what is free and what is paid on the first screen, at 390 px too. */}
      <div class="hero-offer" data-alm-place="home-hero">
        <p class="hero-offer-t">Live levels are free on every page. The paid Lake Level Almanac adds {almYearsMin} to {almYearsMax} years of daily history for one lake.</p>
        <p class="hero-offer-p">${almanacData.priceSingleUsd} once for one lake, or ${almanacData.priceBundleUsd} for all {almanacData.lakeCount} Almanac lakes. 60-day refund.</p>
        <div class="hero-offer-cta">
          <a class="hero-offer-btn" href="/almanac/" data-cta="home_hero_almanac">See the Almanac, from ${almanacData.priceSingleUsd}</a>
          <a class="hero-offer-alt" href="/almanac/sample/" data-cta="home_hero_sample">Open a free sample</a>
        </div>
      </div>
      {/* Lane LD 2026-11-09: the live $9 posters (sku llp), one compact entry in the first
          phone screen and a half, linked to /posters/ (never straight to Stripe). No pop-up. */}
      <a class="home-pst" href="/posters/" data-mm-sku="llp" data-mm-place="home-top" data-mm-link>
        <img src="/posters/img/lake-mead-light-600.webp" width="600" height="800" alt="" loading="eager" decoding="async" />
        <span class="home-pst-t"><span class="home-pst-h">Lake Mead and Lake Powell posters, ${posters.priceUsd}</span>
        <span class="home-pst-s">Lake Mead since {pstSince.mead} and Lake Powell since {pstSince.powell}, drawn from every daily reading. Instant download.</span></span>
        <span class="home-pst-go" aria-hidden="true">›</span>
      </a>
      <p class="home-pst-small">Not useful? Email lipmichal@gmail.com within 14 days for a full refund.</p>
      <ShortAnswer
        question="What are US lake levels right now?"
        answer={`This page lists the ${fresh.length} lakes that have a current reading from USGS or CDEC. Each card shows percent full, the 30-day trend and a plain-English read on whether you can launch a boat. Open a lake for its own gauge and its full pool.`}
        updated={CONTENT_CHECKED}
      />
    </section>

    {/* adsense-mobile 2026-11-02: first ad after the H1, the lead and the short answer. */}
    <AdSlot pos="top" />

    {almFeature && (
      <section class="alm-home">
        <p class="alm-home-k">Is that level normal?</p>
        <p class="alm-home-lead">{almFeatureSentence}</p>
        <p class="alm-home-sub">
          Get daily normal ranges, a threshold explorer and CSV records for {almFeature.name}.
          ${almanacData.priceSingleUsd} once. Instant download. No subscription. 60-day refund, no questions.
        </p>
        <p class="alm-home-cta" data-alm-place="home">
          <a class="alm-home-btn" href={ALMANAC_SINGLE ? `${ALMANAC_SINGLE}?client_reference_id=${almFeature.slug}` : '/almanac'} rel="nofollow" data-lake={almFeature.slug} data-cta="home_almanac_single">
            {almFeature.name} almanac, ${almanacData.priceSingleUsd}
          </a>
          <a class="alm-home-alt" href="/almanac/" data-cta="home_almanac_page">All {almanacData.lakeCount} lakes, ${almanacData.priceBundleUsd} &middot; see a free sample</a>
          <a class="alm-home-sample" href="/almanac/sample/">Open the sample almanac (Lake Powell)</a>
        </p>
        <p class="alm-home-trust">{CHECKOUT_NAME}</p>
      </section>
    )}

    <section class="section">
      <div class="head-row">
        <h2>Lakes with a current reading</h2>
        <a class="see-all" href="/lakes">See all →</a>
      </div>
      <div class="grid cols-2">
        {fresh.map(({ lake, reading }, i) => {
          const st = levelStatus(lake.slug, reading);
          const hex = toneHex(st.tone);
          const val = reading.pct_full != null ? `${reading.pct_full}%` : `${fmtNum(reading.level_ft,1)} ft`;
          // Elevation-only lakes have no %full; size the bar to the status bucket
          // (a qualitative proxy) so it never reads a misleading 0% on a live lake.
          const barProxy = ({ green: 92, cyan: 72, amber: 48, red: 18 } as const)[st.tone];
          const bar = reading.pct_full != null ? `${reading.pct_full}%` : `${barProxy}%`;
          return (
            <>
            {i === 6 && <AdSlot pos="mid" wide />}
            <a class="lake-card" href={`/lake/${lake.slug}`}>
              <div class="top">
                <div><div class="name">{lake.name}</div><div class="sub">{lake.river} · {lake.state}</div></div>
                <div class="val" style={`color:${hex}`}>{val}</div>
              </div>
              <div class="status-row"><span class="d" style={`background:${hex}`}></span><span>{st.label}</span></div>
              <div class="bar"><i style={`width:${bar};background:${hex}`}></i></div>
            </a>
            </>
          );
        })}
      </div>
    </section>

    {fresh.length > 0 && <SupportLine variant="result" headline={`Current readings for ${fresh.length} lakes, in one place. Now you know before you drive.`} />}

    {movers.length > 0 && (
      <section class="section">
        <h2 style="margin-bottom:16px;">Biggest 24-hour movers</h2>
        <div class="table-wrap">
          <table class="movers">
            <thead><tr><th>Lake</th><th>State</th><th class="num">Level</th><th class="num">24h Δ (ft)</th></tr></thead>
            <tbody>
              {movers.map(({ lake, reading }) => {
                const d = reading.delta_24h ?? 0;
                return (
                  <tr>
                    <td><a href={`/lake/${lake.slug}`}><b>{lake.name}</b></a></td>
                    <td class="mut">{lake.state}</td>
                    <td class="num">{reading.pct_full != null ? `${reading.pct_full}%` : `${fmtNum(reading.level_ft,1)} ft`}</td>
                    <td class="num chg">{d >= 0 ? '+' : '−'}{fmtNum(Math.abs(d),0)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="section">
      <h2 style="margin-bottom:16px;">Browse by state</h2>
      <div class="state-grid">
        {Object.entries(states).sort((a,b)=>stateName(a[0]).localeCompare(stateName(b[0]))).map(([code, lakes]) => (
          <a href={`/lakes#${code}`}><div class="sn">{stateName(code)}</div><div class="sc">{lakes.length} lakes</div></a>
        ))}
      </div>
      <div style="margin-top:16px;"><a class="see-all" href="/lakes">See all {LAKES.length} lakes in the registry →</a></div>
    </section>

    <section class="section" id="use-in-ai">
      <h2 style="margin-bottom:8px;">Use this data in Claude or ChatGPT</h2>
      <p style="max-width:66ch;">The same gauge readings are available as a free MCP server, so an AI assistant can look up a lake's current level, recent history or a side-by-side comparison without you copying numbers across. It covers 44 lakes, needs no account or API key, and reads the agency gauges at the time you ask.</p>
      <p style="margin-bottom:6px;"><strong>Claude.ai or ChatGPT.</strong> Add a custom connector and paste this URL.</p>
      <pre class="mono" style="margin:0 0 14px;padding:12px 14px;background:var(--card);border:1px solid var(--border);border-radius:var(--r-sm);font-size:13px;overflow-x:auto;white-space:pre;"><code>https://lake-level-mcp.lipmichal.workers.dev/mcp</code></pre>
      <p style="margin-bottom:6px;"><strong>Claude Code.</strong></p>
      <pre class="mono" style="margin:0 0 14px;padding:12px 14px;background:var(--card);border:1px solid var(--border);border-radius:var(--r-sm);font-size:13px;overflow-x:auto;white-space:pre;"><code>claude mcp add --transport http lake-level https://lake-level-mcp.lipmichal.workers.dev/mcp</code></pre>
      <p style="font-size:13.5px;"><a href="https://github.com/theluckystrike/lake-level-mcp">Source, tools and other install options on GitHub</a></p>
      <p style="font-size:13.5px;">For rivers, a companion server reads live USGS stream gauges and NWS flood forecasts the same way. <a href="https://github.com/theluckystrike/river-level-mcp">River Level MCP on GitHub</a></p>
    </section>

    <section class="section">
      <h2 style="margin-bottom:4px;">Common questions</h2>
      {faqs.map((f) => (
        <div class="faq-item"><div class="q">{f.q}</div><div class="a">{f.a}</div></div>
      ))}
    </section>

    <AdSlot pos="end" />

  </div>
</BaseLayout>

<style>
  /* Lane LD 2026-11-09: compact poster entry in the hero. One tap row, at least 44 px. */
  .home-pst { display: grid; grid-template-columns: 44px 1fr 20px; gap: 12px; align-items: center; margin: 14px 0 0; max-width: 680px;
    padding: 10px 14px; background: var(--card); border: 1px solid var(--border); border-radius: var(--r); color: var(--t1); min-height: 64px; }
  .home-pst:hover { text-decoration: none; border-color: var(--teal); }
  .home-pst img { width: 44px; height: 59px; object-fit: cover; border-radius: 2px; box-shadow: 0 1px 4px rgba(22,40,47,.18); }
  .home-pst-t { display: block; }
  .home-pst-h { display: block; font-size: 16px; font-weight: 700; color: var(--teal); line-height: 1.35; }
  .home-pst-s { display: block; font-size: 16px; line-height: 1.4; color: var(--t2); margin-top: 2px; }
  .home-pst-go { font-size: 26px; color: var(--teal); line-height: 1; }
  .home-pst-small { margin: 6px 0 0; font-size: 16px; color: var(--t2); max-width: 680px; }
  .alm-home { border: 1px solid var(--border); border-left: 4px solid var(--teal);
    border-radius: 0 12px 12px 0; padding: 22px 24px; margin: 4px 0 8px;
    background: var(--card); }
  .alm-home-k { font-size: 13px; font-weight: 600; color: var(--t2); margin: 0 0 10px;
    letter-spacing: .01em; }
  .alm-home-lead { font-size: clamp(18px, 2.6vw, 23px); font-weight: 650; line-height: 1.38;
    margin: 0 0 12px; max-width: 40ch; }
  .alm-home-sub { font-size: 14.5px; line-height: 1.6; color: var(--t1); margin: 0;
    max-width: 66ch; }
  .alm-home-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
    margin: 18px 0 0; }
  .alm-home-btn { display: inline-block; background: var(--teal); color: #fff;
    font-weight: 600; font-size: 15px; padding: 12px 20px; border-radius: 8px;
    text-decoration: none; }
  .alm-home-btn:hover { filter: brightness(1.08); }
  .alm-home-alt { font-size: 14px; font-weight: 500; }
  .alm-home-sample { flex-basis: 100%; font-size: 13.5px; color: var(--t2); }
  .alm-home-trust { font-size: 12.5px; line-height: 1.5; color: var(--t2); margin: 10px 0 0; }
  @media (max-width: 560px) {
    .alm-home { padding: 18px 18px; }
    .alm-home-btn { width: 100%; text-align: center; }
    .alm-home-cta { gap: 12px; }
  }
</style>
