---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { LAKES, freshLakes, byState, getReading, status, fmtNum, stateName } from '../lib/lakes';
import { authorLd, breadcrumbLd } from '../lib/seo';
import almanacData from '../data/almanac.json';
import SupportLine from '../components/SupportLine.astro';

// Hand-tuned 2026-10-08 for "lake levels" / "current lake levels" (1,922 impressions, pos 18).
// The count is the lakes that have a live percent-full reading today, never the registry size.
const pctCount = freshLakes().filter((x) => x.reading.pct_full != null).length;
const title = pctCount >= 5
  ? `Lake levels today: live % full for ${pctCount} US reservoirs`
  : 'Live US lake & reservoir water levels';
const description = SITE.description;
const fresh = freshLakes();
const toneHex = (t: string) => t === 'red' ? '#bb5a37' : t === 'amber' ? '#b07d1a' : t === 'green' || t === 'cyan' ? '#0b7d6a' : '#8a949a';

const movers = [...fresh]
  .map(({ lake, reading }) => ({ lake, reading, d: Math.abs(reading.delta_24h ?? 0) }))
  .sort((a, b) => b.d - a.d)
  .slice(0, 6);

const states = byState();

const faqs = [
  { q: 'Where does the lake level data come from?', a: `Directly from public water-data feeds: USGS Water Services for most lakes and CDEC for California reservoirs. ${SITE.name} fetches each lake's own gage, so the number you see is the same one the operator reports.` },
  { q: 'How often are the levels updated?', a: 'USGS instantaneous gages update every 15–60 minutes; CDEC storage is daily. Each reading carries a timestamp so you can see exactly when it was taken.' },
  { q: 'What does "percent full" mean?', a: 'Current storage divided by published full capacity, as a percentage. 100% means full pool; low percentages indicate drawdown for drought, flood control, or water supply.' },
  { q: 'Is the level shown in real time?', a: 'Almost. It is the most recent reading from the source, usually minutes to hours old. Always confirm conditions with the lake operator before heading out.' },
];
const ld = [authorLd(), breadcrumbLd([{ name: 'Home', path: '/' }])];
// The homepage carries 22.9% of all site impressions (4,220 in the 46 days to 2026-08-05)
// at an average position of 30.25, and it sold nothing, because it asked for nothing.
// Rather than a generic promo, it leads with whichever covered lake is furthest from its
// own normal today. That is a real headline, it changes on its own, and it is the single
// claim on this domain that no competitor can reproduce.
const almLakes = almanacData.lakes;
const almFeature = [...almLakes].sort(
  (a, b) => Math.abs(b.percentile - 50) - Math.abs(a.percentile - 50)
)[0];
const ALMANAC_SINGLE = import.meta.env.PUBLIC_ALMANAC_LINK_SINGLE || '';

---
<BaseLayout title={title} description={description} path="/" jsonLd={ld}>
  <div class="container">

    <section class="hero">
      <div class="live-badge"><span class="dot"></span><span>{fresh.length} lakes live now</span></div>
      <h1>Live US lake &amp; reservoir water levels</h1>
      <p class="lead">Percent full and 30-day trend from USGS and CDEC gages, with a plain-English read on whether you can launch a boat.</p>
    </section>

    {almFeature && (
      <section class="alm-home">
        <p class="alm-home-k">Is that level normal?</p>
        <p class="alm-home-lead">{almFeature.sentence}</p>
        <p class="alm-home-sub">
          Get daily normal ranges, a threshold explorer and CSV records for {almFeature.name}.
          ${almanacData.priceSingleUsd} once. Instant download. No subscription.
        </p>
        <p class="alm-home-cta" data-alm-place="home">
          <a class="alm-home-btn" href={ALMANAC_SINGLE ? `${ALMANAC_SINGLE}?client_reference_id=${almFeature.slug}` : '/almanac'} rel="nofollow" data-lake={almFeature.slug}>
            {almFeature.name} almanac, ${almanacData.priceSingleUsd}
          </a>
          <a class="alm-home-alt" href="/almanac/">All {almanacData.lakeCount} lakes, ${almanacData.priceBundleUsd} &middot; see a free sample</a>
          <a class="alm-home-sample" href="/almanac/sample/">Open the sample almanac (Lake Powell)</a>
        </p>
        <p class="alm-home-trust">Checkout runs on Stripe under our parent company, BeLikeNative (Autom8 LLC). That name appears on the receipt and card statement.</p>
      </section>
    )}

    <section class="section">
      <div class="head-row">
        <h2>Lakes with a current reading</h2>
        <a class="see-all" href="/lakes">See all →</a>
      </div>
      <div class="grid cols-2">
        {fresh.map(({ lake, reading }) => {
          const st = status(reading.pct_full, reading.feet_from_full);
          const hex = toneHex(st.tone);
          const val = reading.pct_full != null ? `${reading.pct_full}%` : `${fmtNum(reading.level_ft,1)} ft`;
          // Elevation-only lakes have no %full; size the bar to the status bucket
          // (a qualitative proxy) so it never reads a misleading 0% on a live lake.
          const barProxy = ({ green: 92, cyan: 72, amber: 48, red: 18 } as const)[st.tone];
          const bar = reading.pct_full != null ? `${reading.pct_full}%` : `${barProxy}%`;
          return (
            <a class="lake-card" href={`/lake/${lake.slug}`}>
              <div class="top">
                <div><div class="name">{lake.name}</div><div class="sub">{lake.river} · {lake.state}</div></div>
                <div class="val" style={`color:${hex}`}>{val}</div>
              </div>
              <div class="status-row"><span class="d" style={`background:${hex}`}></span><span>{st.label}</span></div>
              <div class="bar"><i style={`width:${bar};background:${hex}`}></i></div>
            </a>
          );
        })}
      </div>
    </section>

    <SupportLine variant="result" />

    {movers.length > 0 && (
      <section class="section">
        <h2 style="margin-bottom:16px;">Biggest 24-hour movers</h2>
        <div class="table-wrap">
          <table class="movers">
            <thead><tr><th>Lake</th><th>State</th><th class="num">Level</th><th class="num">24h Δ (ft)</th></tr></thead>
            <tbody>
              {movers.map(({ lake, reading }) => {
                const d = reading.delta_24h ?? 0;
                return (
                  <tr>
                    <td><a href={`/lake/${lake.slug}`}><b>{lake.name}</b></a></td>
                    <td class="mut">{lake.state}</td>
                    <td class="num">{reading.pct_full != null ? `${reading.pct_full}%` : `${fmtNum(reading.level_ft,1)} ft`}</td>
                    <td class="num chg">{d >= 0 ? '+' : '−'}{fmtNum(Math.abs(d),0)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="section">
      <h2 style="margin-bottom:16px;">Browse by state</h2>
      <div class="state-grid">
        {Object.entries(states).sort((a,b)=>stateName(a[0]).localeCompare(stateName(b[0]))).map(([code, lakes]) => (
          <a href={`/lakes#${code}`}><div class="sn">{stateName(code)}</div><div class="sc">{lakes.length} lakes</div></a>
        ))}
      </div>
      <div style="margin-top:16px;"><a class="see-all" href="/lakes">See all {LAKES.length} lakes in the registry →</a></div>
    </section>

    <section class="section">
      <h2 style="margin-bottom:4px;">Common questions</h2>
      {faqs.map((f) => (
        <div class="faq-item"><div class="q">{f.q}</div><div class="a">{f.a}</div></div>
      ))}
    </section>

  </div>
</BaseLayout>

<style>
  .alm-home { border: 1px solid var(--border); border-left: 4px solid var(--teal);
    border-radius: 0 12px 12px 0; padding: 22px 24px; margin: 4px 0 8px;
    background: var(--card); }
  .alm-home-k { font-size: 13px; font-weight: 600; color: var(--t2); margin: 0 0 10px;
    letter-spacing: .01em; }
  .alm-home-lead { font-size: clamp(18px, 2.6vw, 23px); font-weight: 650; line-height: 1.38;
    margin: 0 0 12px; max-width: 40ch; }
  .alm-home-sub { font-size: 14.5px; line-height: 1.6; color: var(--t1); margin: 0;
    max-width: 66ch; }
  .alm-home-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
    margin: 18px 0 0; }
  .alm-home-btn { display: inline-block; background: var(--teal); color: #fff;
    font-weight: 600; font-size: 15px; padding: 12px 20px; border-radius: 8px;
    text-decoration: none; }
  .alm-home-btn:hover { filter: brightness(1.08); }
  .alm-home-alt { font-size: 14px; font-weight: 500; }
  .alm-home-sample { flex-basis: 100%; font-size: 13.5px; color: var(--t2); }
  .alm-home-trust { font-size: 12.5px; line-height: 1.5; color: var(--t2); margin: 10px 0 0; }
  @media (max-width: 560px) {
    .alm-home { padding: 18px 18px; }
    .alm-home-btn { width: 100%; text-align: center; }
    .alm-home-cta { gap: 12px; }
  }
</style>
