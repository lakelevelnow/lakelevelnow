---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { LAKES, byState, getReading, status, fmtNum, stateName, lastReadingDate } from '../../lib/lakes';
import { breadcrumbLd } from '../../lib/seo';
import { levelStatus } from '../../lib/seasonal';
const title = 'All lakes: directory';
const description = `Every lake and reservoir ${SITE.name} tracks, with current level and percent full where a live gage is wired. Browse by state.`;
const states = byState();
const ld = [breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Lakes', path: '/lakes' }])];
const liveCount = LAKES.filter((l) => getReading(l.slug)?.fresh).length;
const toneHex = (t: string) => t === 'red' ? '#bb5a37' : t === 'amber' ? '#b07d1a' : '#0b7d6a';
---
<BaseLayout title={title} description={description} path="/lakes" jsonLd={ld}>
  <div class="container">
    <section class="hero" style="padding-bottom:0;">
      <h1>All lakes</h1>
      <p class="lead">{LAKES.length} lakes in the registry · {liveCount} with a live reading right now. Lakes without a live gage yet show reference data and activate as feeds are wired.</p>
    </section>

    {Object.entries(states).sort((a,b)=>stateName(a[0]).localeCompare(stateName(b[0]))).map(([code, lakes]) => (
      <section class="section" id={code}>
        <h2 style="margin-bottom:16px;">{stateName(code)} <span class="mut" style="font-size:.7em;font-weight:500;">({lakes.length})</span></h2>
        {code === 'CA' && (
          <p class="mut" style="font-size:13px;margin:-8px 0 14px;max-width:660px;">Every reservoir in CDEC's daily storage summary, each ranked against its own record for the date, are on the <a href="/california-lake-levels/">California lake levels</a> page. If two sites quote a different elevation for the same lake, <a href="/guides/why-lake-elevations-differ/">this explains why</a>.</p>
        )}
        <div class="table-wrap">
          <table>
            <thead><tr><th>Lake</th><th>River</th><th>Operator</th><th class="num">Level</th><th>Status</th></tr></thead>
            <tbody>
              {lakes.map((l) => {
                const r = getReading(l.slug); const live = !!(r && r.fresh); const st = levelStatus(l.slug, r); const hex = toneHex(st.tone);
                return (
                  <tr>
                    <td><a href={`/lake/${l.slug}`}><b>{l.name}</b></a></td>
                    <td class="mut">{l.river}</td>
                    <td class="mut">{l.operator}</td>
                    <td class="num">{(live || (r && (r.pct_full != null || r.level_ft != null))) ? (r!.pct_full != null ? `${r!.pct_full}%` : `${fmtNum(r!.level_ft,1)} ft`) : 'n/a'}</td>
                    <td>{live ? <span class={`pill ${st.tone==='red'?'red':st.tone==='amber'?'amber':'green'}`}>{st.label}</span> : (r && (r.pct_full != null || r.level_ft != null)) ? <span class="mut" style="font-size:12px;">last reading {lastReadingDate(r.as_of)}</span> : <span class="mut" style="font-size:12px;">no public feed</span>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
